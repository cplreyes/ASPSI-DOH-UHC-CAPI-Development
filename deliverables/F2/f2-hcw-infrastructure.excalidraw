    {
      "type": "text", "id": "t_etl", "x": 1350, "y": 672, "width": 460, "height": 60,
      "text": "the instruments NEVER join in the database.\nthey join downstream: the ETL reads all 5 DBs over SSH\n(F2 whitelisted — password hashes never leave the box)\nand emits shared_dimensions.csv",
      "originalText": "the instruments NEVER join in the database.\nthey join downstream: the ETL reads all 5 DBs over SSH\n(F2 whitelisted — password hashes never leave the box)\nand emits shared_dimensions.csv",
