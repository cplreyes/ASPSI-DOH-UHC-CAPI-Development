    {
      "type": "text", "id": "t_db_note", "x": 1438, "y": 588, "width": 370, "height": 56,
      "text": "SEPARATE DBs, ONE SERVER — namespacing and\nleast-privilege (f2api granted only on csweb_f2.*),\nbut zero isolation from load or failure.",
      "originalText": "SEPARATE DBs, ONE SERVER — namespacing and\nleast-privilege (f2api granted only on csweb_f2.*),\nbut zero isolation from load or failure.",
