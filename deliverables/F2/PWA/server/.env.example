# f2-api — names only; values are Carl-placed (box: /opt/app/.env). NEVER commit values.
JWT_SIGNING_KEY=   # FRESH key generated ON the box by p2-box-steps.sh (openssl rand); NOT the
                   # Worker's (CF secrets are write-only). Old Worker tokens don't verify — P5
                   # re-enrolls all devices. No P6 rotation debt (never transited chat).
F2_DB_HOST=database
F2_DB_PORT=3306
F2_DB_USER=f2api
F2_DB_PASSWORD=    # least-priv MySQL user, generated on-box (see ddl/f2_api_tables.sql)
F2_DB_NAME=csweb_f2
F2_FILES_DIR=/opt/app/f2-files   # admin file bytes, flat, keyed by file_id (R2 replacement)
F2_WWW_DIR=/opt/app/f2-www       # P3 static PWA dir; unset = API-only mode
PWA_ORIGIN=https://uhc-hcw.asiansocial.org   # enroll_url QR links
PWA_VERSION=       # Versioning panel — deploy_model_c_full.sh stamps all four at deploy
PWA_BUILD_SHA=
API_VERSION=
API_DEPLOYED_AT=
PORT=8787
