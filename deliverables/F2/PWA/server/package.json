{
  "name": "f2-api",
  "version": "0.1.1",
  "private": true,
  "description": "F2 HCW Survey API on uhc-hcw.asiansocial.org — Worker-compatible /exec + /verify-token backed by csweb_f2 MySQL (F2-Prod-Migration-Plan P1)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
