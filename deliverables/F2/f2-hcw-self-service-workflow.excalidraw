    {"type":"rectangle","id":"box_hybrid","x":60,"y":1720,"width":1510,"height":100,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300045,"version":1,"versionNonce":300046,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"txt_hybrid","x":80,"y":1736,"width":1470,"height":72,"text":"RECOMMENDED — HYBRID:  pre-load the known roster (numbered slots you can chase for non-response)  AND  allow self-register for walk-ins the frame missed.\nThe build = a self-register endpoint (reuses the existing atomic QN counter) + a facility-token mint + a dedup guard + device-binding.\nConsent · refusal · offline sync · admin monitoring are all inherited unchanged — so the survey core carries zero risk.","originalText":"RECOMMENDED — HYBRID:  pre-load the known roster (numbered slots you can chase for non-response)  AND  allow self-register for walk-ins the frame missed.\nThe build = a self-register endpoint (reuses the existing atomic QN counter) + a facility-token mint + a dedup guard + device-binding.\nConsent · refusal · offline sync · admin monitoring are all inherited unchanged — so the survey core carries zero risk.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300047,"version":1,"versionNonce":300048,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.4}
