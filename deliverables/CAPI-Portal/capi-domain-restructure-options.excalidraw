    { "id": "banner_txt", "type": "text", "x": 60, "y": 932, "width": 1460, "height": 50, "angle": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 500002, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "frameId": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "★ RECOMMENDATION — Option C (= A now, coherence later): the PORTAL is the brand, hostnames are plumbing. Build capi.asiansocial.org this week,\nsend Ma'am Juvy ONE email asking for BOTH records (capi + hcw), and revisit the csweb alias only after pretest at a natural redeploy boundary.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "banner", "originalText": "★ RECOMMENDATION — Option C (= A now, coherence later): the PORTAL is the brand, hostnames are plumbing. Build capi.asiansocial.org this week,\nsend Ma'am Juvy ONE email asking for BOTH records (capi + hcw), and revisit the csweb alias only after pretest at a natural redeploy boundary.", "lineHeight": 1.3 }
