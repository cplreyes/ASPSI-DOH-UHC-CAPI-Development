    { "id": "optB_bullets", "type": "text", "x": 570, "y": 742, "width": 440, "height": 130, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 300007, "version": 1, "versionNonce": 1, "isDeleted": false, "groupIds": [], "frameId": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "✗ CSWeb under a PATH = invasive PHP proxy surgery\n✗ fleet churn lands right before PRETEST\n✗ nobody types sync URLs — pain buys aesthetics\n✗ weeks of rewiring vs days of portal-building\n✓ perfectly uniform naming (the only win)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✗ CSWeb under a PATH = invasive PHP proxy surgery\n✗ fleet churn lands right before PRETEST\n✗ nobody types sync URLs — pain buys aesthetics\n✗ weeks of rewiring vs days of portal-building\n✓ perfectly uniform naming (the only win)", "lineHeight": 1.35 },

