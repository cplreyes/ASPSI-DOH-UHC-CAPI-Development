      "seed": 100042, "version": 1, "versionNonce": 100042, "isDeleted": false,
      "boundElements": [], "updated": 1, "link": null, "locked": false,
      "text": "THE TENSION: a case that never started jumps the ICF entirely today.\nPut consent BEFORE BREAKOFF and every dead case walks two read-aloud screens first.",
