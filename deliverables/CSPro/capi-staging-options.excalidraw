    { "id": "c_note", "type": "text", "x": 1260, "y": 723, "width": 560, "height": 96,
      "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [],
      "seed": 400008, "version": 1, "versionNonce": 400008, "isDeleted": false, "boundElements": [],
      "updated": 1, "link": null, "locked": false,
      "text": "A label warns a human reading the screen.\nIt does not stop a bad build from installing,\nand it cannot rehearse the sync round-trip.",
      "originalText": "A label warns a human reading the screen.\nIt does not stop a bad build from installing,\nand it cannot rehearse the sync round-trip.",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "lineHeight": 1.5 },

    { "id": "c_bul", "type": "text", "x": 1260, "y": 838, "width": 570, "height": 150,
      "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [],
      "seed": 400009, "version": 1, "versionNonce": 400009, "isDeleted": false, "boundElements": [],
      "updated": 1, "link": null, "locked": false,
      "text": "OK  Zero cost, already in place, fine for UAT today\nX   During fieldwork a fix reaches 147 enumerators\n     with no dry run of install + sync\nX   No safe place to practise a rollback\nX   Every deploy is the first time it has been tried",
      "originalText": "OK  Zero cost, already in place, fine for UAT today\nX   During fieldwork a fix reaches 147 enumerators\n     with no dry run of install + sync\nX   No safe place to practise a rollback\nX   Every deploy is the first time it has been tried",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "lineHeight": 1.5 },

