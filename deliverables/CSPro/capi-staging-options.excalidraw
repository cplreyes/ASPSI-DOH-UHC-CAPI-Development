      "seed": 300012, "version": 1, "versionNonce": 300012, "isDeleted": false, "boundElements": [],
      "updated": 1, "link": null, "locked": false,
      "text": "DictionaryHelper.php:174\nCREATE TABLE IF NOT EXISTS `$dictName`\n\ntable is named by DICTIONARY, not package",
      "originalText": "DictionaryHelper.php:174\nCREATE TABLE IF NOT EXISTS `$dictName`\n\ntable is named by DICTIONARY, not package",
