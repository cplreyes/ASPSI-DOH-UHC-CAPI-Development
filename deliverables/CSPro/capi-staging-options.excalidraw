    { "id": "b_bul", "type": "text", "x": 700, "y": 838, "width": 510, "height": 150,
      "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [],
      "seed": 300013, "version": 1, "versionNonce": 300013, "isDeleted": false, "boundElements": [],
      "updated": 1, "link": null, "locked": false,
      "text": "OK  Zero infrastructure, works today\nX   Test cases land in the LIVE data table\nX   Corruption is invisible until the dataset is analysed\nX   Only safe for does-it-install / does-it-render checks\nX   Renaming the dict to separate them would move the\n     codebook, the tabulations and the ETL",
      "originalText": "OK  Zero infrastructure, works today\nX   Test cases land in the LIVE data table\nX   Corruption is invisible until the dataset is analysed\nX   Only safe for does-it-install / does-it-render checks\nX   Renaming the dict to separate them would move the\n     codebook, the tabulations and the ETL",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "containerId": null, "lineHeight": 1.5 },

