    { "id": "rec", "type": "rectangle", "x": 80, "y": 1040, "width": 1740, "height": 110,
      "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid",
      "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [],
      "seed": 400011, "version": 1, "versionNonce": 400011, "isDeleted": false,
      "boundElements": [{ "type": "text", "id": "rec_lbl" }],
      "updated": 1, "link": null, "locked": false },
    { "id": "rec_lbl", "type": "text", "x": 100, "y": 1055, "width": 1700, "height": 80,
      "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [],
      "seed": 400012, "version": 1, "versionNonce": 400012, "isDeleted": false, "boundElements": [],
      "updated": 1, "link": null, "locked": false,
      "text": "RECOMMENDATION -  Option A, built during the Sept 07 training window while nobody is collecting data yet.\nB is a false economy: it isolates the package but not the data, and the damage only shows up at analysis. C is fine until fieldwork starts.\nPromotion becomes: workspace -> bench -> pilot -> STAGING -> fleet, with the staging round-trip as gate G6a.",
      "originalText": "RECOMMENDATION -  Option A, built during the Sept 07 training window while nobody is collecting data yet.\nB is a false economy: it isolates the package but not the data, and the damage only shows up at analysis. C is fine until fieldwork starts.\nPromotion becomes: workspace -> bench -> pilot -> STAGING -> fleet, with the staging round-trip as gate G6a.",
      "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "containerId": "rec", "lineHeight": 1.45 }
  ]
