PROC Q106_DAYS
postproc
  if Q106_DAYS < 0 or Q106_DAYS > 365 then
    errmsg(1224);
    reenter;
  endif;
  if Q106_DAYS > 90 then
    errmsg(1225, Q106_DAYS);
  endif;
  if Q106_NIGHTS + Q106_DAYS < 1 then
    errmsg(1226);
    reenter;
  endif;
  { #554: nights/days pair sanity — neither can be 0 while the other is > 1 }
  if Q106_DAYS > 1 and Q106_NIGHTS = 0 then
    errmsg(1227, Q106_DAYS);
    reenter;
  endif;
  if Q106_NIGHTS > 1 and Q106_DAYS = 0 then
    errmsg(1228, Q106_NIGHTS);
    reenter;
  endif;

PROC DATE_FIRST_VISITED
postproc
  numeric fvMM; numeric fvDD; numeric fvYY; numeric fvHead;
  if DATE_FIRST_VISITED <> notappl then
    fvMM   = int(DATE_FIRST_VISITED / 1000000);
    fvHead = int(DATE_FIRST_VISITED / 10000);
    if fvMM >= 1 and fvMM <= 12 then
      fvDD = fvHead - fvMM * 100;
      fvYY = DATE_FIRST_VISITED - fvHead * 10000;
      if fvDD < 1 or fvDD > 31 or fvYY < 2020 or fvYY > 2035 then
        errmsg(1268);
        reenter;
      endif;
      DATE_FIRST_VISITED = fvYY * 10000 + fvMM * 100 + fvDD;
    else
      if fvHead < 2020 or fvHead > 2035 then
        errmsg(1268);
        reenter;
      endif;
    endif;
  endif;

PROC DATE_FINAL_VISIT
postproc
  numeric lvMM; numeric lvDD; numeric lvYY; numeric lvHead;
  if DATE_FINAL_VISIT <> notappl then
    lvMM   = int(DATE_FINAL_VISIT / 1000000);
    lvHead = int(DATE_FINAL_VISIT / 10000);
    if lvMM >= 1 and lvMM <= 12 then
      lvDD = lvHead - lvMM * 100;
      lvYY = DATE_FINAL_VISIT - lvHead * 10000;
      if lvDD < 1 or lvDD > 31 or lvYY < 2020 or lvYY > 2035 then
        errmsg(1268);
        reenter;
      endif;
      DATE_FINAL_VISIT = lvYY * 10000 + lvMM * 100 + lvDD;
    else
      if lvHead < 2020 or lvHead > 2035 then
        errmsg(1268);
        reenter;
      endif;
    endif;
  endif;
  { conversion above runs FIRST so both sides below are YYYYMMDD. The notappl guards
    match F1: without them a blank final date (single visit) false-fires this. }
  if DATE_FINAL_VISIT <> notappl and DATE_FIRST_VISITED <> notappl and DATE_FINAL_VISIT < DATE_FIRST_VISITED then
    errmsg(1229);
    reenter;
  endif;

PROC Q124_MAIFIP_HEARD
preproc
  if pos("07", Q113_SOURCES) > 0 then
    Q124_MAIFIP_HEARD = 1;   { already availed MAIFIP in Q113 -> heard = Yes, not re-asked }
    noinput;
  endif;
postproc
  if Q124_MAIFIP_HEARD = 2 then
    skip to Q130_REDUCED_SPEND;   { No (and did not avail) -> skip Q125-Q129; IDK option removed per #1289 }
  endif;

{ ---- Soft plausibility cross-field warnings (spec §3.5-§3.13) ---- }
PROC Q84_SERVICE_TYPE
postproc
  if Q84_SERVICE_TYPE = 1 and PATIENT_TYPE = 2 then
    errmsg(1230);
  endif;
  if Q84_SERVICE_TYPE = 2 and PATIENT_TYPE = 1 then
    errmsg(1231);
  endif;

