PROC Q112_PAY_LINE
preproc
  { Build one row per ticked source (canonical order). The curocc()-th ticked
    source -> Q112_PAY_SRC (auto + protected); end once past the last ticked source. Non-money rows
    default amount 0 but stay enterable.
    Re-runs on back-navigation. }
  numeric nsel; numeric seen;
  nsel = 0;
  if pos("01", Q112_SOURCES) > 0 then nsel = nsel + 1; endif;
  if pos("02", Q112_SOURCES) > 0 then nsel = nsel + 1; endif;
  if pos("03", Q112_SOURCES) > 0 then nsel = nsel + 1; endif;
