{ ---- Q113 payment roster (Option B fan-out) ---- }
PROC Q113_SOURCES
postproc
  { Require >=1 source ticked — the roster grid needs >=1 row. }
  if length(strip(Q113_SOURCES)) = 0 then
    errmsg(1171);
    reenter;
  endif;

PROC Q113_PAY_LINE
preproc
  { Build one row per ticked source (canonical order). The curocc()-th ticked
    source -> Q113_PAY_SRC (auto + protected); end once past the last ticked source. Every row
    amount stays enterable (all sources carry an amount).
    Re-runs on back-navigation. }
  numeric nsel; numeric pp;
  nsel = length(strip(Q113_SOURCES)) / 2;
  if curocc() > nsel then endgroup; endif;
  pp = (curocc() - 1) * 2 + 1;
  Q113_PAY_SRC = tonumber(Q113_SOURCES[pp:2]);
  protect(Q113_PAY_SRC, true);
  Q113_PAY_LINE = curocc();
  noinput;

PROC Q113_PAY_AMT
postproc
  if Q113_PAY_AMT < 0 then
    errmsg(1172);
    reenter;
  endif;

PROC Q113_PAY_OTHER_TXT
preproc
  numeric gk; numeric gn; numeric gp; numeric gt;
  gt = 0; gn = length(strip(Q113_SOURCES)) / 2;
  do gk = 1 while gk <= gn
    gp = (gk - 1) * 2 + 1;
    if Q113_SOURCES[gp:2] = "13" then gt = 1; endif;
  enddo;
  if gt = 0 then
    Q113_PAY_OTHER_TXT = "";   { not ticked -> not enterable }
    noinput;
  endif;
postproc
  numeric hk; numeric hn; numeric hp; numeric ht;
  ht = 0; hn = length(strip(Q113_SOURCES)) / 2;
  do hk = 1 while hk <= hn
    hp = (hk - 1) * 2 + 1;
    if Q113_SOURCES[hp:2] = "13" then ht = 1; endif;
  enddo;
  if ht = 1 and length(strip(Q113_PAY_OTHER_TXT)) = 0 then
    errmsg(1174);
    reenter;
  endif;


