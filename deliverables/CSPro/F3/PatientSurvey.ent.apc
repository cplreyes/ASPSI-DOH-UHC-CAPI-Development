  if pos("08", Q112_SOURCES) > 0 then nsel = nsel + 1; endif;
  if pos("09", Q112_SOURCES) > 0 then nsel = nsel + 1; endif;
  if curocc() > nsel then endgroup; endif;
  seen = 0;
  if pos("01", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 1; endif; endif;
  if pos("02", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 2; endif; endif;
  if pos("03", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 3; endif; endif;
