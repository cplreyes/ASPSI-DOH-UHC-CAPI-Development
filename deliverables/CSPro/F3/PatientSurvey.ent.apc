  if pos("06", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 6; endif; endif;
  if pos("07", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 7; endif; endif;
  if pos("08", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 8; endif; endif;
  if pos("09", Q112_SOURCES) > 0 then seen = seen + 1; if seen = curocc() then Q112_PAY_SRC = 9; endif; endif;
  protect(Q112_PAY_SRC, true);
  if Q112_PAY_SRC = 8 then
    Q112_PAY_AMT = 0;   { non-money source -> default 0; still enterable }
  endif;
  Q112_PAY_LINE = curocc();
