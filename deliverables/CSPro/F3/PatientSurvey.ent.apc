PROC Q85_CONDITIONS
postproc
  numeric q85N; numeric q85K; numeric q85P; numeric q85Hit19;
  if length(strip(Q85_CONDITIONS)) = 0 then
    errmsg(1109);
    reenter;
  endif;
  { #435/#673 + 2026-07-02 #450-class fix: '19' membership chunk-scans — pos("19", ...)
    false-matched across code boundaries (01+99 packs "0199"), both firing the stand-alone
    warn on innocent combos AND falsely satisfying the Q83 cross-check. }
  q85Hit19 = 0;
  q85N = length(strip(Q85_CONDITIONS)) / 2;
  do q85K = 1 while q85K <= q85N
    q85P = (q85K - 1) * 2 + 1;
    if tonumber(Q85_CONDITIONS[q85P:2]) = 19 then q85Hit19 = 1; endif;
  enddo;
  if Q83_VISIT_REASON = 4 and q85Hit19 = 0 then
    errmsg(1110);
  endif;
  if q85Hit19 = 1 and length(strip(Q85_CONDITIONS)) > 2 then
    errmsg(1111);
  endif;

