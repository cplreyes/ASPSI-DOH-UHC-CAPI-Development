    if tonumber(Q82_KON_WHY_NOT_REG[otP:2]) = 99 then otHit = 1; endif;
  enddo;
  if otHit = 0 then
    Q82_KON_WHY_NOT_REG_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked -> not enterable }
    noinput;
  endif;
postproc
  numeric otN2; numeric otK2; numeric otP2; numeric otHit2;
  otHit2 = 0;
  otN2 = length(strip(Q82_KON_WHY_NOT_REG)) / 2;
  do otK2 = 1 while otK2 <= otN2
    otP2 = (otK2 - 1) * 2 + 1;
    if tonumber(Q82_KON_WHY_NOT_REG[otP2:2]) = 99 then otHit2 = 1; endif;
  enddo;
  if otHit2 = 1 and length(strip(Q82_KON_WHY_NOT_REG_OTHER_TXT)) = 0 then
    errmsg(1108);
    reenter;
  endif;

