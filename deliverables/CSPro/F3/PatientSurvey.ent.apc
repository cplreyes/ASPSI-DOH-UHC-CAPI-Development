PROC Q106_NIGHTS
postproc
  if (Q106_NIGHTS < 0 or Q106_NIGHTS > 365) then
    errmsg(1218);
    reenter;
  endif;
  if Q106_NIGHTS > 90 then
    errmsg(1219, Q106_NIGHTS);
  endif;

PROC Q115_FINAL_CASH
postproc
  if (Q115_FINAL_CASH < 0 or Q115_FINAL_CASH > 999999999) then
    errmsg(1220);
    reenter;
  endif;

PROC Q150_TRAVEL_HH
postproc
  if (Q150_TRAVEL_HH < 0 or Q150_TRAVEL_HH > 24) then
    errmsg(1221);
    reenter;
  endif;

PROC Q150_TRAVEL_MM
postproc
  if (Q150_TRAVEL_MM < 0 or Q150_TRAVEL_MM > 59) then
    errmsg(1222);
    reenter;
  endif;
  if Q145_PURCHASE_FREQ <> 5 and Q150_TRAVEL_HH = 0 and Q150_TRAVEL_MM = 0 then
    errmsg(1223);
  endif;

PROC Q106_DAYS
postproc
  if Q106_DAYS < 0 or Q106_DAYS > 365 then
    errmsg(1224);
    reenter;
  endif;
  if Q106_DAYS > 90 then
    errmsg(1225, Q106_DAYS);
  endif;
  if Q106_NIGHTS + Q106_DAYS < 1 then
    errmsg(1226);
    reenter;
  endif;
  { #554: nights/days pair sanity — neither can be 0 while the other is > 1 }
  if Q106_DAYS > 1 and Q106_NIGHTS = 0 then
    errmsg(1227, Q106_DAYS);
    reenter;
  endif;
  if Q106_NIGHTS > 1 and Q106_DAYS = 0 then
    errmsg(1228, Q106_NIGHTS);
    reenter;
  endif;

PROC DATE_FINAL_VISIT
postproc
  if DATE_FINAL_VISIT < DATE_FIRST_VISITED then
    errmsg(1229);
    reenter;
  endif;

PROC Q124_MAIFIP_HEARD
preproc
  if pos("07", Q113_SOURCES) > 0 then
    Q124_MAIFIP_HEARD = 1;   { already availed MAIFIP in Q113 -> heard = Yes, not re-asked }
    noinput;
  endif;
postproc
  if Q124_MAIFIP_HEARD in 2,3 then
    skip to Q130_REDUCED_SPEND;   { No / IDK (and did not avail) -> skip Q125-Q129 }
  endif;

