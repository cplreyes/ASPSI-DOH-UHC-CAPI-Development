            {
              "name": "Q123_ZBB_EXTENT",
              "labels": [
                {
                  "text": "123. To what extent did ZBB reduce your financial burden?",
                  "language": "EN"
                },
                {
                  "text": "Hanggang saan nabawasan ng ZBB ang inyong pinansyal na pasanin?",
                  "language": "FIL"
                },
                {
                  "text": "Hanggang sain kaya an ZBB nakabawas sa saimong problema sa pambayad?",
                  "language": "BCL"
                },
                {
                  "text": "Hangtod unsa nga lebel nakatabang ang ZBB sa pagpakunhod sa imong pinansyal nga kabug-at?",
                  "language": "BIS"
                },
                {
                  "text": "Hangtod unsa nga ang-ang nakapakunhod ang ZBB sa imong pinansyal nga palas-anon?",
                  "language": "CEB"
                },
                {
                  "text": "Tubtob diin naibanan han ZBB an imo pinansyal nga kabug-at?",
                  "language": "WAR"
                },
                {
                  "text": "Sa ano ka dako nga extent ginpakunhod sang ZBB ang imo pinansyal nga kabug-atan?",
                  "language": "HIL"
                },
                {
                  "text": "Agingga iti ania a tukad a pinabassit ti ZBB ti pinansial a dadagsenmo?)",
                  "language": "ILO"
                }
              ],
              "contentType": "numeric",
              "length": 1,
              "zeroFill": false,
              "valueSets": [
                {
                  "name": "Q123_ZBB_EXTENT_VS1",
                  "labels": [
                    {
                      "text": "123. To what extent did ZBB reduce your financial burden?",
                      "language": "EN"
                    },
                    {
                      "text": "Hanggang saan nabawasan ng ZBB ang inyong pinansyal na pasanin?",
                      "language": "FIL"
                    },
                    {
                      "text": "Hanggang sain kaya an ZBB nakabawas sa saimong problema sa pambayad?",
                      "language": "BCL"
                    },
                    {
                      "text": "Hangtod unsa nga lebel nakatabang ang ZBB sa pagpakunhod sa imong pinansyal nga kabug-at?",
                      "language": "BIS"
