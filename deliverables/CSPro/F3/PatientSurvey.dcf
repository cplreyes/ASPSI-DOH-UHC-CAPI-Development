                    {
                      "labels": [
                        {
                          "text": "Probably used PhilHealth but cannot remember amount because benefit was deducted upon discharge from hospital",
                          "language": "EN"
                        },
                        {
                          "text": "Maaaring ginamit ang PhilHealth pero hindi matandaan ang halaga dahil na-deduct ng madischarge sa ospital",
                          "language": "FIL"
                        },
                        {
                          "text": "Ginamit an Philhealth pero dain na narumduman an kantidad na binawas kan siya nadischarge",
                          "language": "BCL"
                        },
                        {
                          "text": "Tingali nagamit ang PhilHealth pero dili na mahinumduman ang kantidad kay gi-deduct na ang benepisyo pag-discharge sa ospital",
                          "language": "BIS"
                        },
                        {
                          "text": "Tingali nakagamit og PhilHealth pero dili mahinumduman ang kantidad kay gi-deduct na ang benepisyo paggawas sa ospital",
                          "language": "CEB"
                        },
                        {
                          "text": "Siguro gingamit an PhilHealth pero diri nahinunumduman an kantidad kay gin-ibanan an benepisyo paggawas ha ospital",
                          "language": "WAR"
                        },
                        {
                          "text": "Siguro gin-usar ang PhilHealth pero indi makahinumdom sang kantidad bangud ang benepisyo gin-deduct sa tion sang pagguwa sa ospital",
