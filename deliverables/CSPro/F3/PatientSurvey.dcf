              "name": "Q53_HAS_PCP",
              "labels": [
                {
                  "text": "53. Do you have a primary care provider?",
                  "language": "EN"
                },
                {
                  "text": "Mayroon ba kayong tagapagbigay ng pangunahing pangangalagang pangkalusugan (primary care provider)?",
                  "language": "FIL"
                },
                {
                  "text": "Igwa ba kamo ki primary care provider?",
                  "language": "BCL"
                },
                {
                  "text": "Aduna ba kay primary care provider?",
                  "language": "BIS"
                },
                {
                  "text": "A primary care provider is your first contact healthcare provider (i.e., general practitioner doctor) for an undiagnosed concern or continuing care of varied medical conditions",
                  "language": "CEB"
                },
                {
                  "text": "Mayda ka ba panguna nga nag-aataman?",
                  "language": "WAR"
                },
                {
                  "text": "May ara ka bala sang",
                  "language": "HIL"
                },
                {
                  "text": "(Adda kadi kangrunaan a mangipapaay iti panangaywanmo?) A",
                  "language": "ILO"
                }
