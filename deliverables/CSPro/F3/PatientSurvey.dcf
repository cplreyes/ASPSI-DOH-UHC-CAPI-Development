            {
              "name": "Q174_PCP_DISCUSSED",
              "labels": [
                {
                  "text": "174. Did your primary care provider discuss with you different places you could have gone to get help with your problem?",
                  "language": "EN"
                },
                {
                  "text": "Tinalakay ba ng iyong pangunahing health provider sa iyo ang iba\u2019t ibang lugar na maaari mong puntahan upang makakuha ng tulong para sa iyong problema?",
                  "language": "FIL"
