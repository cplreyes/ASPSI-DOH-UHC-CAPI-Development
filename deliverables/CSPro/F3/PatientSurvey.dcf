              "labels": [
                {
                  "text": "140. In most recent visit, how often did the staff ask you for your consent before performing any treatments or tests?",
                  "language": "EN"
                },
                {
                  "text": "tinanong ka ba para sa iyong pahintulot bago isagawa ang anumang paggamot o pagsusuri?",
                  "language": "FIL"
                },
                {
                  "text": "Naghagad saimo nin pahintulot bago maggibo nin anomang pagbulong o test?",
                  "language": "BCL"
                },
