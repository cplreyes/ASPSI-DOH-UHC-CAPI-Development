            {
              "name": "Q87_OTHER_ACTIONS",
              "labels": [
                {
                  "text": "87. Apart from this visit, has the patient done anything else to improve his/her health condition or address his/her health concern?",
                  "language": "EN"
                },
                {
                  "text": "Bukod sa pagbisitang ito, may ginawa pa bang iba ang pasyente upang gamutin ang kanyang kondisyon?",
                  "language": "FIL"
                },
                {
                  "text": "Bukod sa pagbisita na ini, may iba ka bang ginigibo para sa ma-improve an kondisyon o ma-address an saimong health concern?",
                  "language": "BCL"
                },
                {
                  "text": "Gawas niini nga pagbisita, aduna pa bay laing gibuhat ang pasyente aron mapaayo ang iyang kondisyon sa panglawas o masulbad ang iyang concern sa panglawas?",
                  "language": "BIS"
                },
                {
                  "text": "Gawas ani nga pagbisita, naa pa bay laing gihimo ang pasyente para mapauswag ang iyang kahimtang sa panglawas o masulbad ang iyang problema sa panglawas?",
                  "language": "CEB"
                },
                {
                  "text": "Labot hini nga pagbisita, mayda pa ba ginbuhat an pasyente para mapaupay an iya kondisyon ha panlawas o mabaton an iya kabaraka ha panlawas?",
                  "language": "WAR"
                },
                {
                  "text": "Luwas sa sini nga bisita, may ginbuhat pa bala ang pasyente agud mapaayo ang iya kahimtang sang lawas ukon masolbar ang iya problema sa panlawas?",
                  "language": "HIL"
                },
                {
                  "text": "Malaksid iti daytoy a panagbisitana, adda kadi sabali nga inaramid ti pasiente a mangpasayaat iti kasasaad ti salun- atna wenno mangtaming iti pakaseknanna iti salun-at?",
                  "language": "ILO"
                }
              ],
