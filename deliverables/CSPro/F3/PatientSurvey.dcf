              "labels": [
                {
                  "text": "70. What mode/s of transportation do you use when travelling to the health facility that you usually go to?",
                  "language": "EN"
                },
                {
                  "text": "Anong uri ng transportasyon ang ginagamit ninyo kapag bumibiyahe patungo sa karaniwaang pasilidad pangkalusugan na pinupuntahan ninyo?",
                  "language": "FIL"
                },
                {
                  "text": "Anong klase kan transportasyon an tigagamit mo kada ika nagaduman sa health facility na pirmi mo tigadumanan?",
                  "language": "BCL"
                },
                {
                  "text": "Unsang paagi/pamaagi sa transportasyon ang imong gigamit kung mobiyahe paingon sa health facility nga imong kasagarang adtoan?",
                  "language": "BIS"
                },
                {
                  "text": "Unsa nga paagi sa transportasyon ang imong gigamit sa pag-adto sa pasilidad sa panglawas nga kasagaran nimong adtoan?",
                  "language": "CEB"
                },
                {
                  "text": "Ano nga paagi/mga transportasyon an iyo ginagamit kun nagbibiyahe ngadto ha pasilidad panlawas nga iyo kasagaran kakadtoan?",
                  "language": "WAR"
                },
                {
                  "text": "Ano nga paagi/pamagi sa transportasyon ang imo ginagamit kon nagabiyahe ka pakadto sa health facility nga imo permi ginakadtoan?",
                  "language": "HIL"
                },
                {
                  "text": "Ania a wagas/dagiti wagas ti transportasion ti usarem no agbiaheka nga agturong iti pasilidad ti salun-at a gagangay a papanam?",
                  "language": "ILO"
                }
