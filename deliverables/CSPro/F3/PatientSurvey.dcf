            {
              "name": "Q19_HH_SIZE",
              "labels": [
                {
                  "text": "19. How many total individuals (including children) live in the patient's house now?",
                  "language": "EN"
                },
                {
                  "text": "Ilan lahat ang indibidwal (kasama ang mga bata) ang kasalukuyang nakatira sa bahay ng pasyente?",
                  "language": "FIL"
                },
                {
                  "text": "Pira an total na indibiwal (kasabay an mga aki) na nakaistar ngonyan sa harong?",
                  "language": "BCL"
                },
                {
                  "text": "Pila tanan ang nagpuyo kauban ang mga bata sa balay sa pasyente?",
                  "language": "BIS"
                },
                {
                  "text": "Pila ka mga indibidwal (apil ang mga bata) ang nagpuyo karon sa balay sa pasyente?",
                  "language": "CEB"
                },
                {
                  "text": "Pira kabug-usan nga indibidwal (upod na an kabataan) an naukoy yana ha balay han pasyente?",
                  "language": "WAR"
                },
                {
                  "text": "Pila ka total nga tawo (lakip na ang mga kabataan) ang nagaestar sa balay sang pasyente subong? Please count the patient and all the people who",
                  "language": "HIL"
                },
                {
                  "text": "(Mano a dagup nga indibidual (agraman dagiti ubbing) ti agnanaed iti balay ti pasiente ita?) Please count the patient and all the people who",
                  "language": "ILO"
                }
              ],
