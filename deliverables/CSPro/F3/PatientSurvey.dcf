                  "values": [
                    {
                      "labels": [
                        {
                          "text": "This facility is more accessible than my usual facility (i.e., nearer, has more transportation options to get to, and cheaper to travel to)",
                          "language": "EN"
                        },
                        {
                          "text": "Mas madaling puntahan ang pasilidad na ito kaysa sa karaniwan kong pinupuntahang pasilidad (hal., mas malapit, maraming pagpipilian sa transportasyon, at mas mura ang biyahe)",
                          "language": "FIL"
                        },
                        {
                          "text": "Mas accessible ini kumpara sa usual na facility (harani sana, may mas marhay na transportasyon, mas barato)",
                          "language": "BCL"
                        },
                        {
                          "text": "Mas accessible kini nga pasilidad kaysa sa akong kasagarang pasilidad (pananglitan: mas duol, mas daghang sakyanan padulong didto, ug mas barato ang plete)",
                          "language": "BIS"
                        },
                        {
                          "text": "Mas dali maabot kining pasilidad kumpara sa akong kasagaran nga pasilidad (pananglitan, mas duol, mas daghan og opsyon sa sakyanan paingon, ug mas barato ang pamasahe)",
                          "language": "CEB"
                        },
                        {
                          "text": "Mas madali maabot ini nga pasilidad kaysa han akon nahiaraan nga pasilidad (i.e., mas harani, mayda mas damo nga mga opsyon hin sarakyan nga makadtoan, ngan mas barato an pagbiyahe)",
                          "language": "WAR"
                        },
                        {
                          "text": "Mas masulhay malab-ot ini nga pasilidad kaysa sa akon naandan nga pasilidad (halimbawa, mas malapit, may mas madamo nga opsyon sa transportasyon para makadto, kag mas barato ang biyahe)",
                          "language": "HIL"
                        },
                        {
                          "text": "(Daytoy a pasilidad ket ad- adda a madanon ngem ti gagangay a pasilidadko (i.e., as-asideg, ad-adu ti pagpilian ti transportasion a makadanon, ken nalaklaka a pagbiahean)",
