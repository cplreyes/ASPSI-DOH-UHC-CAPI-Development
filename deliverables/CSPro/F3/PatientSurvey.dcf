                {
                  "text": "Unsa ang sex sa pasyente sa pagkatawo?",
                  "language": "BIS"
                },
                {
                  "text": "Unsa ang sex sa pasyente sa pagkahimugso?",
                  "language": "CEB"
                },
                {
                  "text": "Ano an sekso han pasyente han katawo?",
                  "language": "WAR"
