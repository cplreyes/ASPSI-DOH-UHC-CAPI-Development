  - name: PATIENTSURVEY_DICT.AREA_HAS_GAMOT
    conditions:
      - questionText:
          EN: |
            <p>Does this area have a Guaranteed and Accessible Medications for Outpatient Treatment (GAMOT) pharmacy/package? (Q152-Q159 apply only to areas with GAMOT.)</p>
