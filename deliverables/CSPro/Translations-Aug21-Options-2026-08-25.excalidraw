    {"type":"text","id":"c_l5","x":1064,"y":694,"width":420,"height":34,"text":"Close · two status updates to ASPSI","originalText":"Close · two status updates to ASPSI","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400031,"version":1,"versionNonce":400032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"c_verdict","x":1020,"y":750,"width":480,"height":110,"text":"+ fastest visible coverage jump (most English is\n  unchanged)\n− seven deploys and seven patch notes, not four\n− the items DOH actually changed stay English\n  through pass 1\n− two remove-and-re-add cycles per CSEntry tester\n− same generator work as A, verification paid twice","originalText":"+ fastest visible coverage jump (most English is\n  unchanged)\n− seven deploys and seven patch notes, not four\n− the items DOH actually changed stay English\n  through pass 1\n− two remove-and-re-add cycles per CSEntry tester\n− same generator work as A, verification paid twice","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400033,"version":1,"versionNonce":400034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

