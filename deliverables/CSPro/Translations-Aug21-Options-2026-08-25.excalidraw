    {"type":"text","id":"b_l5","x":574,"y":694,"width":410,"height":34,"text":"Close · one status to ASPSI","originalText":"Close · one status to ASPSI","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300031,"version":1,"versionNonce":300032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"b_verdict","x":530,"y":750,"width":460,"height":110,"text":"+ one announcement, one remove-and-re-add per tester\n+ simplest bookkeeping (one evidence set, one note)\n− nothing ships until F3's generator work lands —\n  the long pole gates everything\n− a late F3 problem holds back F1/F2/F4 work that\n  was done days earlier\n− biggest single-day change two weeks before training","originalText":"+ one announcement, one remove-and-re-add per tester\n+ simplest bookkeeping (one evidence set, one note)\n− nothing ships until F3's generator work lands —\n  the long pole gates everything\n− a late F3 problem holds back F1/F2/F4 work that\n  was done days earlier\n− biggest single-day change two weeks before training","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300033,"version":1,"versionNonce":300034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

