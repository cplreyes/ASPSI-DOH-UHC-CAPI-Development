  "elements": [
    {"type":"text","id":"title","x":80,"y":24,"width":1450,"height":34,"text":"Supervisor Hub  —  one role-gated app, or two role-specific apps?","originalText":"x","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":80,"y":64,"width":1500,"height":22,"text":"Your naming — \"Enumerators App\" / \"Supervisors App\" — implies two apps.  Today it's one, role-gated at login.  Here's the fork.","originalText":"x","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"cur_panel","x":80,"y":104,"width":1520,"height":180,"strokeColor":"#1e40af","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"angle":0,"seed":110003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"cur_label","x":100,"y":118,"width":420,"height":24,"text":"ON THE TABLET TODAY","originalText":"x","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"cur_apps","x":100,"y":148,"width":760,"height":130,"text":"CSEntry — installed apps\n  Supervisor Hub (HUB)          v1.1.4\n  Supervisor Hub Menu (HUB)     v1.1.4   ← the duplicate we kill\n  Facility Head Survey (F1)     v1.1.0\n  Patient Survey (F3)           v1.1.0\n  Household Survey (F4)         v1.4.0","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"cur_tension","x":900,"y":150,"width":690,"height":120,"text":"⚠  It's ONE role-gated hub — the login decides whether you\n     get the supervisor menu or the enumerator menu.\n\n     But one app carries only ONE name, so it can't be both\n     \"Enumerators App\" AND \"Supervisors App\".  That's the fork.","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

    {"type":"line","id":"divider","x":80,"y":304,"width":1520,"height":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"angle":0,"seed":110007,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[1520,0]]},
    {"type":"text","id":"sec_hdr","x":80,"y":316,"width":1000,"height":26,"text":"TWO WAYS TO MAKE YOUR NAMING REAL","originalText":"x","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110008,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"hdr_a","x":80,"y":352,"width":740,"height":24,"text":"OPTION A  ·  Keep ONE app (neutral name)","originalText":"x","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#3b82f6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"panel_a","x":80,"y":388,"width":720,"height":206,"strokeColor":"#3b82f6","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_a","x":98,"y":402,"width":690,"height":180,"text":"CSEntry — everyone's tablet\n\n  UHC Survey Y2 — Field App        v1.1.5\n     ↳ login → role menu (sup / enum)\n     launches F1 / F3 / F4\n\n  (F1 / F3 / F4 installed as today)","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_win","x":80,"y":608,"width":720,"height":46,"text":"✓  One package · one deploy · one version line\n✓  Zero change to today's role-gating logic","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_cost","x":80,"y":660,"width":720,"height":24,"text":"✗  Can't have the two role-specific names you asked for","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_cav","x":80,"y":686,"width":720,"height":24,"text":"○  Wrong-role menu still possible (log in with the other role's account)","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

    {"type":"text","id":"hdr_b","x":860,"y":352,"width":740,"height":24,"text":"★  OPTION B  ·  Split into TWO apps  —  RECOMMENDED","originalText":"x","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"panel_b1","x":860,"y":388,"width":360,"height":206,"strokeColor":"#047857","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_b1","x":878,"y":404,"width":330,"height":180,"text":"Enumerator's tablet\n\n  UHC Survey Y2\n  Enumerators App     v1.1.5\n   ↳ login → enumerator\n     menu\n   launches F1 / F3 / F4","originalText":"x","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"rectangle","id":"panel_b2","x":1240,"y":388,"width":360,"height":206,"strokeColor":"#047857","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_b2","x":1258,"y":404,"width":330,"height":180,"text":"Supervisor's tablet\n\n  UHC Survey Y2\n  Supervisors App     v1.1.5\n   ↳ login → supervisor\n     menu\n   assign · collect · relay","originalText":"x","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bb_win","x":860,"y":608,"width":740,"height":70,"text":"✓  Exactly your names (login screen header = \"… App Login\")\n✓  No wrong-role menu — role fixed by which app you install\n✓  Enumerators get ONE entry point, not raw F1 / F3 / F4","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bb_cost","x":860,"y":686,"width":740,"height":24,"text":"✗  Two generated packages → two CSWeb deploys / version lines","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130007,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bb_cav","x":860,"y":712,"width":740,"height":24,"text":"○  Shifts the field flow (open Enumerators App, not F4 direct) — post-pretest","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130008,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

    {"type":"rectangle","id":"rec_panel","x":80,"y":760,"width":1520,"height":110,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":140001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"rec_text","x":102,"y":772,"width":1476,"height":88,"text":"✔  Option B fits the naming you want, unifies the enumerator experience, and removes the wrong-role risk.\nCost = two generated hub packages (a role flag in build_hub_apps.py) + two deploys — /capi-release treats them as two apps, one version line each.\nF1/F3/F4 stay shared (they can also join the \"UHC Survey Y2 — …\" family).   Detail: app-list Description carries the version; the login-form header adds \"Login\".","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#065f46","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":140002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4}
