                    {
                      "text": "91. Why did you go to this facility?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "This facility is more accessible than my usual facility (i.e., nearer, has more transportation options to get to, and cheaper to travel to)",
                          "language": "EN"
                        },
                        {
                          "text": "Mas madaling ma-access ang pasilidad na ito kaysa sa aking karaniwang pinupuntahan (hal. mas malapit, mas maraming transportasyon, at mas mura ang pamasahe)",
                          "language": "FIL"
                        },
                        {
                          "text": "Mas accessible ini kumpara sa dati kung pigduduman na pasilidad (harani, may mas marhay na transportasyon, mas barato an pamasahe)",
                          "language": "BCL"
                        },
                        {
                          "text": "Mas dali maadtoan kini nga pasilidad kaysa akong kasagarang adtoan (pananglitan: mas duol, mas daghan sakyanan padulong didto, ug mas barato ang plete)",
                          "language": "BIS"
                        },
                        {
                          "text": "Mas dali maabot kining pasilidad kumpara sa akong kasagaran nga pasilidad (pananglitan, mas duol, mas daghan og opsyon sa sakyanan paingon, ug mas barato ang pamasahe)",
                          "language": "CEB"
                        },
                        {
                          "text": "Mas madali maabot ini nga pasilidad kaysa han akon nahiaraan nga pasilidad (i.e., mas harani, mayda mas damo nga mga opsyon hin sarakyan nga makadtoan, ngan mas barato an pagbiyahe)",
                          "language": "WAR"
                        },
                        {
                          "text": "Mas masami nga ma\u2011access ini nga pasilidad kaysa sa akon masami nga ginakadtoan (malapit, mas damo sang opsyon sa transportasyon, kag mas barato ang biyahe)",
                          "language": "HIL"
                        },
                        {
                          "text": "(Daytoy a pasilidad ket ad- adda a madanon ngem ti gagangay a pasilidadko (i.e., as-asideg, ad-adu ti pagpilian ti transportasion a makadanon, ken nalaklaka a pagbiahean)",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "01"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "Needed a service/specialist not available at my usual facility",
                          "language": "EN"
                        },
                        {
                          "text": "Kailangan ng serbisyo/espesyalista na wala sa aking karaniwang pasilidad",
                          "language": "FIL"
                        },
                        {
                          "text": "Kaipuhan na serbisyo o espesyalista na wara sa nakasanayan na pasilidad",
                          "language": "BCL"
                        },
                        {
                          "text": "Nanginahanglan og serbisyo o espesyalista nga wala sa akong kasagarang pasilidad",
                          "language": "BIS"
                        },
                        {
                          "text": "Nagkinahanglan og serbisyo/espeyalista nga wala sa akong kasagaran nga pasilidad",
                          "language": "CEB"
