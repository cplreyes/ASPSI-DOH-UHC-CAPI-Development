            {
              "name": "Q201_WORRIED",
              "labels": [
                {
                  "text": "201. How worried are you about your household's finances in the next 1 month?",
                  "language": "EN"
                },
                {
                  "text": "Gaano kayo nag-aalala tungkol sa pinansyal na kalagayan ng inyong sambahayan sa susunod na 1 buwan?",
                  "language": "FIL"
                },
                {
                  "text": "Gurano ka kahadit na an saindong household finances sa sunod na 1 sarong bulan?",
                  "language": "BCL"
                },
                {
                  "text": "Unsa ka dako ang imong kabalaka bahin sa pinansyal nga kahimtang sa inyong panimalay sulod sa sunod nga 1 ka bulan?",
                  "language": "BIS"
                },
                {
                  "text": "Unsa ka kabalaka bahin sa pinansyal nga kahimtang sa inyong panimalay sa sunod nga 1 ka bulan?",
                  "language": "CEB"
                },
                {
                  "text": "Mationan-o ka kabaraka ha panalapi han imo panimalay ha masunod nga 1 ka bulan?",
                  "language": "WAR"
                },
                {
                  "text": "Ano ka daku ang inyo pagkabalaka parte sa kwarta sang inyo panimalay sa masunod nga isa ka bulan?",
                  "language": "HIL"
                },
                {
                  "text": "Kasano ti pannakadanaganmo iti pinansial ti sangakabbalayanmo iti sumaruno a 1 a bulan?",
                  "language": "ILO"
                }
