                          "text": "Patient does not pay any hospital bill",
                          "language": "EN"
                        },
                        {
                          "text": "Hindi nagbabayad ang pasyente ng anumang bayarin sa ospital",
                          "language": "FIL"
                        },
                        {
                          "text": "An pasyente dai na nagbabayad nin maski anong hospital bill",
                          "language": "BCL"
                        },
                        {
                          "text": "Ang pasyente dili mobayad bisan unsang bayronon sa ospital",
                          "language": "BIS"
                        },
                        {
                          "text": "Ang pasyente dili na magbayad sa bayronon sa ospital",
                          "language": "CEB"
                        },
                        {
                          "text": "An pasyente waray magbayad hin bisan ano nga baraydan ha ospital",
                          "language": "WAR"
                        },
                        {
                          "text": "Ang pasyente wala nagabayad sang hospital bill",
                          "language": "HIL"
                        },
                        {
                          "text": "Saan nga agbayad ti pasiente iti aniaman a bayadan iti ospital",
