                          "language": "BCL"
                        },
                        {
                          "text": "Nakatabang sa pagpakunhod sa out-of-pocket nga gasto sa tambal",
                          "language": "BIS"
                        },
                        {
                          "text": "Makatabang sa pagpaminos sa gasto sa tambal gikan sa kaugalingong bulsa",
                          "language": "CEB"
                        },
                        {
                          "text": "Nakakabulig nga maibanan an gastos ha gawas han bulsa para han mga medisina",
