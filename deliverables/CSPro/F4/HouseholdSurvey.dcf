                },
                {
                  "text": "Maaram ka ba han kaibahan han 'branded' ngan 'generic' nga medisina?",
                  "language": "WAR"
                },
                {
                  "text": "Nakahibalo ka bala sang kaibahan sa tunga sang \u2018",
                  "language": "HIL"
                },
                {
                  "text": "(Ammom kadi ti nagdumaan ti \u2018",
                  "language": "ILO"
                }
              ],
