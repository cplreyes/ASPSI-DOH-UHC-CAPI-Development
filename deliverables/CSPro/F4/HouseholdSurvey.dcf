              "labels": [
                {
                  "text": "63. Was the most recent medicine purchased prescribed by a doctor or over-the-counter (OTC) medicine (no need for a prescription)?",
                  "language": "EN"
                },
                {
                  "text": "Ang pinakahuling gamot na binili ba ay may reseta ng doktor o nabili ng hindi kailangan ang reseta over-the-counter (OTC)?",
                  "language": "FIL"
                },
                {
                  "text": "Ang pinaka recent na binakal na bulong tigprescribe saimo kan doctor o over-the-counter (OTC) na bulong (dai kaipuhan ki reseta)?",
