                        {
                          "text": "Nagbibigay ng libre o abot-kayang gamot para sa mga outpatients",
                          "language": "FIL"
                        },
                        {
                          "text": "Nagtataong libre o affordable na medisina para sa outpatients",
                          "language": "BCL"
                        },
                        {
                          "text": "Naghatag og libre o abot-kayang tambal para sa mga outpatients",
                          "language": "BIS"
                        },
                        {
                          "text": "Nagahatag og libre o barato nga mga tambal para sa mga outpatient",
                          "language": "CEB"
                        },
                        {
                          "text": "Naghahatag hin libre o barato nga medisina para ha mga outpatient o mga pasyente nga aada gawas",
                          "language": "WAR"
                        },
                        {
                          "text": "Nagahatag sang libre ukon barato nga bulong para sa mga outpatient",
                          "language": "HIL"
                        },
                        {
                          "text": "Mangipaay kadagiti libre wenno makabael nga agas para kadagiti outpatient",
                          "language": "ILO"
