              "name": "Q60_BUCAS_ACCESSED",
              "labels": [
                {
                  "text": "60. In the last six months, did you or any member of your HH accessed the services in a BUCAS center?",
                  "language": "EN"
                },
                {
                  "text": "Sa nakalipas na anim na buwan, ikaw ba o ang sinumang miyembro ng inyong sambahayan ay gumamit ng mga serbisyo sa isang BUCAS Center?",
                  "language": "FIL"
