            {
              "name": "Q99_PHONE_ADVICE_CLOSED",
              "labels": [
                {
                  "text": "99. When your primary care facility is closed, is there a phone number you can call when you get sick?",
                  "language": "EN"
                },
                {
                  "text": "Kapag sarado ang iyong primary care facility, mayroon ka bang numero ng telepono na maaari mong tawagan kapag ikaw ay nagkasakit?",
                  "language": "FIL"
                },
                {
                  "text": "Kun sarado an primary care facility, may phone number ka pwedeng apudan?",
                  "language": "BCL"
                },
                {
                  "text": "Kung sirado ang pasilidad, adunay bay number sa selpon nga matawagan kung magkasakit ka?",
                  "language": "BIS"
                },
                {
                  "text": "Kung sirado ang inyong primary care facility, naa bay numero sa telepono nga pwede nimo tawagan kung magsakit ka?",
                  "language": "CEB"
                },
                {
                  "text": "Kun sarado an iyo pasilidad han panguna nga pag-ataman, mayda ba numero han telepono nga matatawagan nga iyo matatawagan kun magkasakit kamo?",
                  "language": "WAR"
                },
                {
                  "text": "Kon sirado ang imo primary care facility, may ara bala sang numero sa telepono nga mahimo mo tawagan kon magamasakit ikaw? Yes Oo No Indi",
                  "language": "HIL"
                },
                {
                  "text": "No naserraan ti pasilidad ti kangrunaan a panangaywanmo, adda kadi numero ti telepono a mabalinmo nga awagan no agsakitka?) Yes (Wen) No (Saan",
                  "language": "ILO"
                }
