PROC Q177_HEALTH_12M_SUBTOTAL_TOTAL_PHP
preproc
  { Health subtotal (device-proven pattern): TOTAL field's OWN preproc + noinput, LOCAL
    accumulator; sums CONSUMED=1 rows of N_H12M_ROSTER. #834: 'in 0:99999999' excludes
    notappl AND the -98/-99 sentinels (#743). Not protect(), not a group proc. }
  numeric nsr_i; numeric nsr_total;
  nsr_total = 0;
  do nsr_i = 1 while nsr_i <= 2
    if N_H12M_CONSUMED(nsr_i) = 1 then
      if N_H12M_PURCHASED_PHP(nsr_i) in 0:99999999 then
        nsr_total = nsr_total + N_H12M_PURCHASED_PHP(nsr_i);
      endif;
      if N_H12M_INKIND_PHP(nsr_i) in 0:99999999 then
        nsr_total = nsr_total + N_H12M_INKIND_PHP(nsr_i);
      endif;
    endif;
  enddo;
  Q177_HEALTH_12M_SUBTOTAL_TOTAL_PHP = nsr_total;
  noinput;

PROC N_H6M_ITEM
preproc
  { Auto-name this grid row from the WHO/SHA item list (one occurrence per item). }
  if curocc() = 1 then N_H6M_ITEM = "178. Preventive services such as immunization/vaccinations services and other preventive services (e.g., tetanus toxoid for pregnant women, and routine immunization such as BCG during well child visits). Exclude the cost of vaccine itself.";
  elseif curocc() = 2 then N_H6M_ITEM = "179. Diagnostic and laboratory tests, such as blood tests and x-rays, for other reasons than preventive care";
  elseif curocc() = 3 then N_H6M_ITEM = "180. Assistive health products for vision (e.g., glasses), hearing (e.g., hearing aids), and mobility (e.g., crutches, therapeutic footwear), including repair, rental, and online purchases";
  elseif curocc() = 4 then N_H6M_ITEM = "181. Medical products (e.g., antigen tests, glucose meters, masks), including online purchases";
  endif;
  noinput;

PROC N_H6M_PURCHASED_PHP
preproc
  { #834 Option A: not consumed -> auto 0 + noinput. Consumed -> LEFT ENTERABLE, NO
    special() pre-fill (it clobbered stored amounts on resume-replay, #834).
    Completeness checked once at section end (Q186), not per row. }
  if N_H6M_CONSUMED = 2 then
    N_H6M_PURCHASED_PHP = 0;
    noinput;
  endif;

postproc
  { Range.docx hardening (2026-07-08): valid = 0..99999999 (width caps the max)
    or the -98/-99 sentinels; block stray negatives (CSEntry accepts a typed
    minus). Replay-safe: the partial-save resume transient reads 0/notappl,
    never < 0 (#834/#835 class checked before adding). }
  if N_H6M_PURCHASED_PHP < 0 and N_H6M_PURCHASED_PHP <> -98 and N_H6M_PURCHASED_PHP <> -99 then
    errmsg(1156);
    reenter;
  endif;

PROC N_H6M_INKIND_PHP
preproc
  { #834 Option A: not consumed -> auto 0 + noinput. Consumed -> LEFT ENTERABLE, NO
