{ ---- Section N end-of-section: #834 completeness reminder + expenditure recap (review.html) ---- }
PROC Q186_CURRENT_INCOME
preproc
  { All locals declared first (CSPro: declarations precede executable statements). }
  numeric nmiss; numeric mchk;
  numeric srv_i;
  numeric srv_rest; numeric srv_smoke;
  numeric srv_nf1m; numeric srv_nf6m; numeric srv_nf12m;
  numeric srv_grand;
  string  srv_j; string srv_res;
  { #834 Option A: section-end completeness reminder (soft, NO reenter). Counts Section N
    items marked consumed whose amount is still blank or both-zero (same predicate as the
    retired per-row #677) across all 7 rosters, then warns once. Flow always continues. }
  nmiss = 0;
  do mchk = 1 while mchk <= 13
    if N_FOOD_CONSUMED(mchk) = 1 and not (N_FOOD_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_FOOD_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 2
    if N_WKOTH_CONSUMED(mchk) = 1 and not (N_WKOTH_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_WKOTH_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 8
    if N_NF1M_CONSUMED(mchk) = 1 and not (N_NF1M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_NF1M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 2
    if N_NF6M_CONSUMED(mchk) = 1 and not (N_NF6M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_NF6M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 5
    if N_NF12M_CONSUMED(mchk) = 1 and not (N_NF12M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_NF12M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 2
    if N_H12M_CONSUMED(mchk) = 1 and not (N_H12M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_H12M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 4
    if N_H6M_CONSUMED(mchk) = 1 and not (N_H6M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_H6M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  do mchk = 1 while mchk <= 2
    if N_H1M_CONSUMED(mchk) = 1 and not (N_H1M_PURCHASED_PHP(mchk) in -99, -98, 1:99999999) and not (N_H1M_INKIND_PHP(mchk) in -99, -98, 1:99999999) then nmiss = nmiss + 1; endif;
  enddo;
  if nmiss > 0 then
    errmsg(1157, nmiss);
  endif;
  { Read back the 9 Section N block subtotals to the respondent before funding sources.
    Stored subtotals read direct; restaurant/smoking/non-food summed here. Every sum uses
    'in 0:99999999' so notappl + -98/-99 are excluded. Informational modal - OK to Q186. }
  { #832/#833: restaurant (Q158) + tobacco (Q159) are N_WKOTH_ROSTER occ 1 + occ 2. }
  srv_rest = 0;
  if N_WKOTH_CONSUMED(1) = 1 then
    if N_WKOTH_PURCHASED_PHP(1) in 0:99999999 then srv_rest = srv_rest + N_WKOTH_PURCHASED_PHP(1); endif;
    if N_WKOTH_INKIND_PHP(1) in 0:99999999 then srv_rest = srv_rest + N_WKOTH_INKIND_PHP(1); endif;
  endif;
  srv_smoke = 0;
  if N_WKOTH_CONSUMED(2) = 1 then
    if N_WKOTH_PURCHASED_PHP(2) in 0:99999999 then srv_smoke = srv_smoke + N_WKOTH_PURCHASED_PHP(2); endif;
    if N_WKOTH_INKIND_PHP(2) in 0:99999999 then srv_smoke = srv_smoke + N_WKOTH_INKIND_PHP(2); endif;
  endif;
  srv_nf1m = 0;
  do srv_i = 1 while srv_i <= 8
    if N_NF1M_CONSUMED(srv_i) = 1 then
      if N_NF1M_PURCHASED_PHP(srv_i) in 0:99999999 then srv_nf1m = srv_nf1m + N_NF1M_PURCHASED_PHP(srv_i); endif;
      if N_NF1M_INKIND_PHP(srv_i) in 0:99999999 then srv_nf1m = srv_nf1m + N_NF1M_INKIND_PHP(srv_i); endif;
    endif;
  enddo;
  srv_nf6m = 0;
  do srv_i = 1 while srv_i <= 2
    if N_NF6M_CONSUMED(srv_i) = 1 then
      if N_NF6M_PURCHASED_PHP(srv_i) in 0:99999999 then srv_nf6m = srv_nf6m + N_NF6M_PURCHASED_PHP(srv_i); endif;
      if N_NF6M_INKIND_PHP(srv_i) in 0:99999999 then srv_nf6m = srv_nf6m + N_NF6M_INKIND_PHP(srv_i); endif;
    endif;
  enddo;
  srv_nf12m = 0;
  do srv_i = 1 while srv_i <= 5
    if N_NF12M_CONSUMED(srv_i) = 1 then
      if N_NF12M_PURCHASED_PHP(srv_i) in 0:99999999 then srv_nf12m = srv_nf12m + N_NF12M_PURCHASED_PHP(srv_i); endif;
      if N_NF12M_INKIND_PHP(srv_i) in 0:99999999 then srv_nf12m = srv_nf12m + N_NF12M_INKIND_PHP(srv_i); endif;
    endif;
  enddo;
  srv_grand = Q157_FOOD_SUBTOTAL_TOTAL_PHP + srv_rest + srv_smoke
            + srv_nf1m + srv_nf6m + srv_nf12m
            + Q177_HEALTH_12M_SUBTOTAL_TOTAL_PHP + Q182_HEALTH_6M_SUBTOTAL_TOTAL_PHP
            + Q185_HEALTH_1M_SUBTOTAL_TOTAL_PHP;
  srv_j = maketext("%d", Q157_FOOD_SUBTOTAL_TOTAL_PHP)
        + "," + maketext("%d", srv_rest) + "," + maketext("%d", srv_smoke)
        + "," + maketext("%d", srv_nf1m) + "," + maketext("%d", srv_nf6m) + "," + maketext("%d", srv_nf12m)
        + "," + maketext("%d", Q177_HEALTH_12M_SUBTOTAL_TOTAL_PHP)
        + "," + maketext("%d", Q182_HEALTH_6M_SUBTOTAL_TOTAL_PHP)
        + "," + maketext("%d", Q185_HEALTH_1M_SUBTOTAL_TOTAL_PHP)
        + "," + maketext("%d", srv_grand);
  srv_res = htmldialog("review.html", inputData := srv_j);


{ ---- Bill-recall cap (spec 4.8): no-receipt amount cannot exceed total bill ----
  1176-aug17: field names updated for the Q139/Q143 renumber (Q141_1_NO_RECEIPT_
  AMT_PHP -> Q143_NO_RECEIPT_AMT_PHP; Q139_FINAL_AMOUNT_PHP -> Q139_TOTAL_BILL_PHP,
  content also changed from "cash paid at discharge" to "total hospital bill" --
  same cap relationship still holds: a professional fee charged with no receipt
  can't exceed the bill it was part of). ---- }
PROC Q143_NO_RECEIPT_AMT_PHP
postproc
  if Q143_NO_RECEIPT_AMT_PHP > Q139_TOTAL_BILL_PHP then
    errmsg(1011,
           Q143_NO_RECEIPT_AMT_PHP, Q139_TOTAL_BILL_PHP);
    reenter;
  endif;


