PROC Q158_RESTAURANT_INKIND_PHP
preproc
  { #832/#833 roster-parity gate (Q144-Q156): not consumed -> 0 + noinput
    (DG-safe, no skip-to, no protect); consumed -> #755/#818 special() pre-fill
    so Enter passes an empty amount. Always enterable when consumed. }
  if Q158_RESTAURANT_CONSUMED = 2 then
    Q158_RESTAURANT_INKIND_PHP = 0;
    noinput;
  else
    if special(Q158_RESTAURANT_INKIND_PHP) then Q158_RESTAURANT_INKIND_PHP = 0; endif;
  endif;
postproc
  if Q158_RESTAURANT_CONSUMED = 1 and not (Q158_RESTAURANT_PURCHASED_PHP in -99, -98, 1:99999999) and not (Q158_RESTAURANT_INKIND_PHP in -99, -98, 1:99999999) then
    errmsg(1010);
    reenter;
  endif;

