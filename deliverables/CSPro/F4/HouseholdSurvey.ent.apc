PROC Q102_VISIT_REASON_OTHER_TXT
preproc
  numeric otN; numeric otK; numeric otP; numeric otHit;
  otHit = 0;
  otN = length(strip(Q102_VISIT_REASON)) / 2;
  do otK = 1 while otK <= otN
    otP = (otK - 1) * 2 + 1;
    if tonumber(Q102_VISIT_REASON[otP:2]) = 99 then otHit = 1; endif;
  enddo;
  if otHit = 0 then
    Q102_VISIT_REASON_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked -> not enterable }
