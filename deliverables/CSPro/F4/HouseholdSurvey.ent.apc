    errmsg(1156);
    reenter;
  endif;

PROC Q182_HEALTH_6M_SUBTOTAL_TOTAL_PHP
preproc
  { Health subtotal (device-proven pattern): TOTAL field's OWN preproc + noinput, LOCAL
    accumulator; sums CONSUMED=1 rows of N_H6M_ROSTER. #834: 'in 0:99999999' excludes
    notappl AND the -98/-99 sentinels (#743). Not protect(), not a group proc. }
  numeric nsr_i; numeric nsr_total;
  nsr_total = 0;
  do nsr_i = 1 while nsr_i <= 4
    if N_H6M_CONSUMED(nsr_i) = 1 then
      if N_H6M_PURCHASED_PHP(nsr_i) in 0:99999999 then
        nsr_total = nsr_total + N_H6M_PURCHASED_PHP(nsr_i);
      endif;
      if N_H6M_INKIND_PHP(nsr_i) in 0:99999999 then
        nsr_total = nsr_total + N_H6M_INKIND_PHP(nsr_i);
      endif;
    endif;
  enddo;
  Q182_HEALTH_6M_SUBTOTAL_TOTAL_PHP = nsr_total;
  noinput;

