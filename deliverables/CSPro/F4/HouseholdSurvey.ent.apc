PROC Q93_WHY_NOT
preproc
  { #624/#650: Q93 (why NO usual facility) applies when Q89=No(2) OR Q89=I-don't-know(3)
    -- both mean no established usual facility. The Q89=Yes/Q90=No path (Q91 -> Q92)
    falls through to here, so skip Q93 for everyone EXCEPT the Q89 No/IDK respondents. }
  if Q89_HAS_USUAL_FACILITY <> 2 and Q89_HAS_USUAL_FACILITY <> 3 then
    skip to Q94_TRANSPORT;
  endif;
postproc
  if length(strip(Q93_WHY_NOT)) = 0 then
    errmsg(1112);
    reenter;
  endif;
  if pos("90", Q93_WHY_NOT) > 0 and length(strip(Q93_WHY_NOT)) > 2 then
    errmsg(1185);
    reenter;
  endif;

