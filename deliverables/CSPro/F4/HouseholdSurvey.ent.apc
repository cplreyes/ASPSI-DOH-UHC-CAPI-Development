PROC Q137_MAIFIP_SOURCE_OTHER_TXT
preproc
  numeric otN; numeric otK; numeric otP; numeric otHit;
  otHit = 0;
  otN = length(strip(Q137_MAIFIP_SOURCE)) / 2;
  do otK = 1 while otK <= otN
    otP = (otK - 1) * 2 + 1;
    if tonumber(Q137_MAIFIP_SOURCE[otP:2]) = 99 then otHit = 1; endif;
  enddo;
  if otHit = 0 then
    Q137_MAIFIP_SOURCE_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked -> not enterable }
    noinput;
  endif;
postproc
  numeric otN2; numeric otK2; numeric otP2; numeric otHit2;
