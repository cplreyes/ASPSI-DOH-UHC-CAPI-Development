    reenter;
  endif;

PROC Q53_UHC_UNDERSTAND_OTHER_TXT
preproc
  numeric otN; numeric otK; numeric otP; numeric otHit;
  otHit = 0;
  otN = length(strip(Q53_UHC_UNDERSTAND)) / 2;
  do otK = 1 while otK <= otN
    otP = (otK - 1) * 2 + 1;
    if tonumber(Q53_UHC_UNDERSTAND[otP:2]) = 99 then otHit = 1; endif;
  enddo;
  if otHit = 0 then
    Q53_UHC_UNDERSTAND_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked -> not enterable }
    noinput;
  endif;
postproc
  numeric otN2; numeric otK2; numeric otP2; numeric otHit2;
  otHit2 = 0;
  otN2 = length(strip(Q53_UHC_UNDERSTAND)) / 2;
