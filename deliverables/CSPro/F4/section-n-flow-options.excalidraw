    {"id":"reco_t","type":"text","x":60,"y":1128,"width":1490,"height":52,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":300010,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"RECOMMENDATION - Hold OPTION A through the pretest (fixed + tester-chosen); pilot the ADD-ONS; put A-vs-B to ASPSI as a one-time written decision ONLY if\npretest enumerators stumble on grid rhythm. Either way: get ASPSI's written blessing for -98/-99 and fix the opening script's two-pass wording.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RECOMMENDATION - Hold OPTION A through the pretest (fixed + tester-chosen); pilot the ADD-ONS; put A-vs-B to ASPSI as a one-time written decision ONLY if\npretest enumerators stumble on grid rhythm. Either way: get ASPSI's written blessing for -98/-99 and fix the opening script's two-pass wording.","lineHeight":1.4,"baseline":15}
