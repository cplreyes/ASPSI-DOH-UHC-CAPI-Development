{ Capture-Helpers — reusable CSPro logic for GPS reads + verification photos.

  Include this module inside each form's .app:
      #include "../shared/Capture-Helpers.apc"

  Prerequisites:
  - Main dictionary must expose the items emitted by
    cspro_helpers._gps_fields(prefix) and _photo_block(prefix).
  - Android tablet with GPS hardware + camera (for photos).

  Usage pattern (example — F1 facility block; warm-radio flow 2026-07-19):

      PROC QUESTIONNAIRE_NUMBER
      preproc
          WarmUpGPS();   { open the radio at case start — fix converges while typing }

      PROC FACILITY_CAPTURE_GPS
      onfocus
          if ReadGPSReading(15, 20) then   { radio already warm -> near-instant }
              FACILITY_GPS_LATITUDE   = maketext("%f", gps(latitude));
              FACILITY_GPS_LONGITUDE  = maketext("%f", gps(longitude));
              FACILITY_GPS_ALTITUDE   = maketext("%f", gps(altitude));
              FACILITY_GPS_ACCURACY   = gps(accuracy);
              FACILITY_GPS_SATELLITES = gps(satellites);
              FACILITY_GPS_READTIME   = gps(readtime);
              ReleaseGPS();   { after the case's LAST GPS use — saves battery }
          endif;
          FACILITY_CAPTURE_GPS = notappl;   { reset trigger so button re-arms }

      PROC CAPTURE_VERIFICATION_PHOTO
      onfocus
          string fn = "case-" + maketext("%d", QUESTIONNAIRE_NO) + "-verification.jpg";
          if TakeVerificationPhoto(fn) then
              VERIFICATION_PHOTO_FILENAME = fn;
          endif;
          CAPTURE_VERIFICATION_PHOTO = notappl;

  References:
  - gps() logic family: CSPro 8.0 Users Guide — Positioning & GPS
  - Image object: CSPro 8.0 Users Guide — Image
  - Popstan Census CAPI sample: Household/Household.ent.apc:171-240
}

PROC GLOBAL

{ ---- Warm-radio GPS state (pretest fix 2026-07-19) ----
  The old flow opened the radio COLD at the capture field, blocked in
  gps(read, 120, 20) while the receiver acquired satellites from scratch
  (30-120 s on the Itel tablets, often the full 120 s indoors), then
  gps(close) threw the fix away — so every retry cold-started again.
  Testers reported the GPS as "so slow".

  New flow: WarmUpGPS() opens the radio at case start (non-blocking, no UI),
  so the receiver tracks satellites while the enumerator types the case key
  and geo IDs. By the GPS form the fix has converged and the short bounded
  read returns in ~1-2 s. The radio stays open between reads (instant
  retries, and F3's second GPS block reads warm); ReleaseGPS() closes it
  after the case's LAST capture. Every capture is still a FRESH gps(read) —
  never a cached gps(readlast) — so a fix can never leak across facilities. }

numeric gpsRadioOpen = 0;   { 1 while this session holds the radio open }
numeric gpsFailedTries = 0; { consecutive failed reads — drives the #1209 retry escalation }


function WarmUpGPS()
    { Open the GPS radio early so acquisition runs in the background.
      Non-blocking (no progress dialog), so it is safe to call from a field
      preproc that re-fires on partial-save resume. }

    { Windows desktop (getos 10..19) has no GPS radio — desk-test no-op. }
    if getos() in 10:19 then
        WarmUpGPS = 0;
        exit;
    endif;

    { #1209: re-assert the radio UNCONDITIONALLY instead of trusting the flag.
      gpsRadioOpen is a PROC GLOBAL, so it outlives the case — but the radio does
      not. A case that ends via endlevel (F3 Postponed / Withdraw, F1 Postponed /
      Refused) never reaches the ReleaseGPS() in its last GPS block, so the flag
      leaked "open" into every later case of the same CSEntry session, and the old
      flag-guard then suppressed gps(open) for the rest of that session — every
      later read failed with "No GPS fix" and the enumerator never even saw the
      hardware/permission message. gps(open) on an already-open radio is a cheap
      no-op, so re-asserting costs nothing on the normal path and self-heals. }
    if gps(open) then
        gpsRadioOpen = 1;
    else
        gpsRadioOpen = 0;
    endif;
    gpsFailedTries = 0;   { fresh warm-up -> the next read gets the short budget }
    { no errmsg on failure here — this is a background warm-up; the
      capture-time read reports hardware problems to the enumerator }

    WarmUpGPS = gpsRadioOpen;
end;


function ReadGPSReading(numeric maxTimeSec, numeric desiredAccuracyM)
    { Takes a FRESH reading within maxTimeSec, reusing the already-warm radio
      when WarmUpGPS() ran at case start (the normal path — returns in ~1-2 s).
      Returns 1 on success / 0 on failure. Caller reads gps(latitude),
      gps(longitude), gps(altitude), gps(accuracy), gps(satellites), and
      gps(readtime) after a successful call. The radio is left OPEN so a
      failed read can be retried instantly — call ReleaseGPS() after the
      case's last capture. }

    { Windows desktop (getos 10..19) has no GPS radio. Skip silently so desk-test
      data entry flows past the capture field with no modal. Android (20..29)
      captures normally — production behaviour is unchanged. }
    if getos() in 10:19 then
        ReadGPSReading = 0;
        exit;
    endif;

    if gpsRadioOpen = 0 then
        if not gps(open) then
            errmsg("GPS hardware unavailable — check tablet location permission.");
            ReadGPSReading = 0;
            exit;
        endif;
        gpsRadioOpen = 1;
    endif;

    { #1209 escalating budget. The FIRST attempt at a field stays short so nobody
      is parked on a dead field, but re-entering the field is an explicit "try
      harder" from the enumerator, so each CONSECUTIVE FAILED read buys a longer
      window (15 -> 30 -> 45 s, capped at 60). A cold receiver needs 30-120 s for
      a first fix, so a flat 15 s could never reach a fix it was seconds away
      from — the retry the message advertises used to be a no-op. Reset on
      success and by WarmUpGPS() at case start. }
    numeric budgetSec = maxTimeSec * (gpsFailedTries + 1);
    if budgetSec > 60 then
        budgetSec = 60;
    endif;

    numeric result = gps(read, budgetSec, desiredAccuracyM);
    { radio deliberately NOT closed — kept warm for retries / later GPS blocks }

    if result <> 1 then
        gpsFailedTries = gpsFailedTries + 1;
        { Clear the flag but do NOT gps(close): closing discards the acquisition
          progress and makes every retry cold-start (the bug fixed 2026-07-19).
          Clearing alone makes the next call re-issue gps(open) — a no-op when the
          radio really is open, and the recovery path when the flag had gone stale
          because an earlier case exited before ReleaseGPS(). }
        gpsRadioOpen = 0;
        errmsg("No GPS fix after %d s. Move outdoors or beside a window, then re-enter this field to retry — each retry searches longer. You may also leave GPS blank and finish the case.",
               budgetSec);
        ReadGPSReading = 0;
        exit;
    endif;

    gpsFailedTries = 0;   { a good read resets the escalation }

    if gps(accuracy) > desiredAccuracyM then
        errmsg("GPS accuracy %d m exceeds target %d m — consider a retry outdoors.",
               gps(accuracy), desiredAccuracyM);
        { still return success — let the caller/enumerator decide to keep or retry }
    endif;

    ReadGPSReading = 1;
end;


function ReleaseGPS()
    { Close the radio after the case's LAST GPS capture (battery). Flag-guarded
      no-op when already closed, so callers may invoke it from protect blocks
      that re-run on back-navigation. }
    if gpsRadioOpen = 1 then
        gps(close);
        gpsRadioOpen = 0;
    endif;
    ReleaseGPS = 1;
end;


function TakeVerificationPhoto(string photoFile)
    { Captures the verification photo INTO the binary Image dictionary item
      VERIFICATION_PHOTO_IMAGE so the JPG bytes travel inside the case and sync
      to CSWeb (downloadable from the CSWeb Data Viewer). Returns 1 on success /
      0 on cancel or no-camera.

      WHY (R4 #713): the previous version saved the photo to a LOOSE FILE via
      Image.save(photoFile) and stored only the filename string in the case.
      CSWeb syncs case RECORD ITEMS, not loose app-folder files, so the photo
      never reached the server ("no picture retained by the system"). Storing the
      bytes in a binary Image item is the supported way to sync a photo to CSWeb.

      `photoFile` IS written to disk as of #727 (an ADDITIVE device-side copy via
      Image.save below); the binary item above remains the CSWeb sync path. The caller
      also keeps `photoFile` as the human-readable label assigned to
      *_VERIFICATION_PHOTO_FILENAME (the "already captured" sentinel onfocus guards on).
      The parameter is kept so callers (F1/F3/F4 CAPTURE_VERIFICATION_PHOTO) need
      no change. NB: it is `photoFile`, not `filename` -- `filename` is a CSPro
      reserved word and errors at compile (verified 2026-06-08).

      This references the dictionary item VERIFICATION_PHOTO_IMAGE by name, so
      every app including this helper must declare it (cspro_helpers._photo_block
      emits it). Binary items cannot be placed on a form, so the item is off-form
      and capture is driven from the on-form CAPTURE_VERIFICATION_PHOTO trigger. }

    { Windows desktop (getos 10..19) has no camera. Skip silently so desk-test
      flows past the capture field with no modal. Android (20..29) captures. }
    if getos() in 10:19 then
        TakeVerificationPhoto = 0;
        exit;
    endif;

    if not VERIFICATION_PHOTO_IMAGE.takePhoto("Take a verification photo for this interview.") then
        TakeVerificationPhoto = 0;
        exit;
    endif;

    { Resample before sync so the embedded JPG stays small (<= 1600 x 1200). }
    VERIFICATION_PHOTO_IMAGE.resample(maxWidth := 1600, maxHeight := 1200);

    { #727 (Carl 2026-06-22): (1) show the captured photo to the enumerator right after
      taking it (confirmation), and (2) save a copy into the device's shared *Pictures*
      folder so it shows in the device Gallery. The CSWeb binary-Image sync (#713) is
      unchanged. view() displays the image held by the object (CSPro 8 Users Guide p.541).
      GALLERY: a bare-filename save goes to the app sandbox and is NOT gallery-visible — but
      CSEntry requests LEGACY external storage (dumpsys-verified on the Itel:
      requestLegacyExternalStorage + hasPreserveLegacyExternalStorage + WRITE_EXTERNAL_STORAGE
      granted), so a raw write to /sdcard/Pictures IS indexed by MediaStore and appears in the
      Gallery. Android-only: the getos() 10:19 guard above skips desktop (no /sdcard there). }
    VERIFICATION_PHOTO_IMAGE.view();
    VERIFICATION_PHOTO_IMAGE.save(pathconcat("/sdcard/Pictures", photoFile), quality := 85);

    TakeVerificationPhoto = 1;
end;
