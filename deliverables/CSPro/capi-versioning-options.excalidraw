    {"type":"text","id":"title","x":80,"y":26,"width":1300,"height":34,"text":"CAPI App Version Control  —  preserve & roll back every deployed build","originalText":"CAPI App Version Control  —  preserve & roll back every deployed build","fontSize":26,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":80,"y":66,"width":1400,"height":22,"text":"The fork: store the built binaries  ·  rebuild from source  ·  or hybrid?      Deliverable = a  /capi-release  skill","originalText":"The fork: store the built binaries  ·  rebuild from source  ·  or hybrid?      Deliverable = a  /capi-release  skill","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

