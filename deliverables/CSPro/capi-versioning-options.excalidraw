    {"type":"text","id":"code_a","x":98,"y":406,"width":440,"height":208,"text":"git tag capi-hub-v1.1.4 → a1b2c3d\n\nreleases/hub/v1.1.4/\n  manifest.json\n    commit:  a1b2c3d\n    inputs:  roster#sha  psgc#sha\n    pff:     \"Hub v1.1.4 (2026-07-15)\"\n\nrollback: checkout tag → restore\n  pinned inputs → rebuild → deploy","originalText":"x","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_win","x":80,"y":642,"width":470,"height":46,"text":"✓  Zero repo bloat (text only)\n✓  Clean git history","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_cost","x":80,"y":692,"width":470,"height":24,"text":"✗  Needs a deterministic build + stored secret inputs","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"ba_cav","x":80,"y":718,"width":470,"height":24,"text":"○  Rollback = a full rebuild","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

    {"type":"text","id":"hdr_b","x":590,"y":358,"width":470,"height":24,"text":"OPTION B  ·  Artifact archive","originalText":"OPTION B  ·  Artifact archive","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"panel_b","x":590,"y":392,"width":470,"height":236,"strokeColor":"#b45309","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_b","x":608,"y":414,"width":440,"height":200,"text":"releases/hub/v1.1.4/     (Git LFS)\n  LoginApp.csds  + 26 files\n  survey-basemap.mbtiles    26 MB\n  FacilityHead / Patient / HH .dcf\n  manifest.json\n\nrollback: grab the bundle →\n  redeploy the exact bytes","originalText":"x","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bb_win","x":590,"y":642,"width":470,"height":46,"text":"✓  Exact-bytes rollback, no rebuild\n✓  Works even if the build varies","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bb_cost","x":590,"y":692,"width":470,"height":46,"text":"✗  ~35 MB / version → Git LFS + repo bloat\n✗  Secrets baked into the stored bundle","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

    {"type":"text","id":"hdr_c","x":1100,"y":358,"width":490,"height":24,"text":"★  OPTION C  ·  Hybrid   —   RECOMMENDED","originalText":"x","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"panel_c","x":1100,"y":392,"width":480,"height":236,"strokeColor":"#047857","backgroundColor":"#1e293b","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_c","x":1118,"y":404,"width":450,"height":216,"text":"releases/hub/v1.1.4/   (committed, tiny)\n  manifest.json   commit + all hashes\n  *.pff           generated text, diff-able\n  CHANGELOG line\n\nbinaries (.pen / .csdb / mbtiles):\n  rebuilt from tag, hash-checked\n\nreleases-cache/   (local, gitignored)\n  last 2-3 bundles → instant redeploy","originalText":"x","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bc_win","x":1100,"y":642,"width":490,"height":70,"text":"✓  Reproduce + provenance + audit\n✓  Tiny repo — manifest + pff = paper trail\n✓  Instant rollback (recent) + reproducible (old)","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"bc_cav","x":1100,"y":716,"width":490,"height":24,"text":"○  More moving parts — the skill hides them","originalText":"x","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

