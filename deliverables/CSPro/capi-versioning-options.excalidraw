    {"type":"text","id":"cur_label","x":100,"y":122,"width":420,"height":24,"text":"WHAT EXISTS TODAY","originalText":"WHAT EXISTS TODAY","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100004,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"cur_body","x":100,"y":152,"width":1460,"height":78,"text":"versions.json  →  stamp_version.py  →  .pff  \"Supervisor Hub v1.1.4\"        ✓  version NUMBERING works\ngit tracks the generators & source    ·    .gitignore excludes   .pen   .csdb   mbtiles   roster-source.csv\n12 git tags  v1.0.0 … v2.1.0     ✗  they don't map to the app versions  (hub is v1.1.4 — there is no v1.1.4 tag)","originalText":"x","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100005,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.35},
    {"type":"text","id":"cur_warn","x":100,"y":244,"width":1460,"height":24,"text":"⚠  No way to reproduce or roll back exactly what CSWeb ran as v1.1.4 — the built package isn't preserved anywhere.","originalText":"x","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100006,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

