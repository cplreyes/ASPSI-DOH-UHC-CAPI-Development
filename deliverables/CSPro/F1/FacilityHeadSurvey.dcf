                    },
                    {
                      "text": "81. What is/are the reason/s for the facility to charge additional capitation fees?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "To cover expenses related to building maintenance, equipment, and non-clinical staff",
                          "language": "EN"
                        },
                        {
                          "text": "Upang tustusan ang mga gastusin na may kaugnayan sa pagpapanatili ng gusali, kagamitan, at hindi-klinikal na staff",
                          "language": "FIL"
                        },
                        {
                          "text": "Para mabayadan an pagmanitinir kan building, mga gamit asin non-clinical staaff",
                          "language": "BCL"
                        },
                        {
                          "text": "Aron mabayaran/masakop ang mga gasto sa pagmentinar sa building, equipment ug mga non-clinical staff",
                          "language": "BIS"
                        },
                        {
                          "text": "Aron matabangan ang mga galastuhan nga may kalabutan sa pagmentina sa building, kagamitan, ug nonclinical staff",
                          "language": "CEB"
                        },
                        {
                          "text": "Basi mataparan an mga gastos may kalabotan ha pagmintinar han tinukod, mga garamiton, ngan diri-klinikal nga mga empleyado",
                          "language": "WAR"
                        },
                        {
                          "text": "Para matabunan ang gastos sa building maintenance, equipment, kag non-clinical staff",
                          "language": "HIL"
                        },
                        {
                          "text": "Tapno masakupan dagiti gastos a mainaig iti pannakamantener ti pasdek, alikamen, ken saan a klinikal a staff",
                          "language": "ILO"
                        }
