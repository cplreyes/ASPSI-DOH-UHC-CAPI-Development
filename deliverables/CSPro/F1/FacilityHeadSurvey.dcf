                  "values": [
                    {
                      "labels": [
                        {
                          "text": "Streamline access to medical and financial aid for indigent and financially incapacitated patients",
                          "language": "EN"
                        },
                        {
                          "text": "Pabilisin ang pag-access sa medikal at pinansyal na tulong para sa mga indigent at financially incapacitated na pasyente",
                          "language": "FIL"
                        },
                        {
                          "text": "Streamline access sa medical asin tabang pinansyal para sa mga indigent asin financially incapacitated patients",
                          "language": "BCL"
                        },
                        {
                          "text": "Pagpasayon sa pag-angkon sa serbisyong medikal ug financial nga tabang alang sa mga kabus ug pinansyal nga dili makaya sa pasyente",
                          "language": "BIS"
                        },
                        {
                          "text": "Ipahapsay ang access sa medikal ug pinansyal nga tabang para sa mga indigent ug mga pasyente nga walay kapasidad sa pinansyal",
                          "language": "CEB"
                        },
                        {
                          "text": "Pag-ayos han pag-angkon hin medikal ngan pinansyal nga bulig para han mga kablas ngan pinansyal nga mga pasyente",
                          "language": "WAR"
                        },
                        {
                          "text": "Pahapuson ang pagkuha sang bulig medikal kag pinansyal para sa mga pasyente nga pigado kag wala sang kapasidad pinansyal",
                          "language": "HIL"
                        },
                        {
                          "text": "Pasayaaten ti pannakagun-od iti medikal ken pinansial a tulong para kadagiti napanglaw ken di makabael iti pinansial a pasiente",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "01"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "Reduce out-of-pocket expenses",
                          "language": "EN"
                        },
                        {
                          "text": "Bawasan ang out-of-pocket expenses",
                          "language": "FIL"
                        },
                        {
                          "text": "Mabawasan an mga out-of-pocket expenses",
                          "language": "BCL"
                        },
                        {
                          "text": "Pag minus sa diretsong gasto nga ginabayaran sa pasyente",
                          "language": "BIS"
                        },
                        {
                          "text": "Pagmenos sa out-of-pocket nga gasto",
                          "language": "CEB"
                        },
                        {
                          "text": "Ibanan an mga gastos ha gawas han bulsa",
                          "language": "WAR"
                        },
                        {
                          "text": "Pagamayon ang gasto nga ginabayad mismo sang pasyente",
                          "language": "HIL"
                        },
                        {
                          "text": "Kissayan dagiti gastos a rummuar iti bulsa.",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "02"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "Eliminate the need to travel to multiple government agencies",
                          "language": "EN"
                        },
                        {
                          "text": "Alisin ang pangangailangan na pumunta sa iba't ibang ahensya ng gobyerno",
                          "language": "FIL"
                        },
                        {
                          "text": "Mahali an kaipuhan na mga travel to multiple government agencies",
                          "language": "BCL"
                        },
                        {
                          "text": "Pagwagtang sa panginahanglan nga mobiyahe sa lain-laing ahensya sa gobyerno",
                          "language": "BIS"
                        },
                        {
                          "text": "Wagtangon ang panginahanglan nga mobiyahe sa daghang ahensya sa gobyerno",
                          "language": "CEB"
                        },
                        {
                          "text": "Tanggalon an panginahanglan nga magbiyahe ngadto hin damo nga mga ahensya han gobyerno",
                          "language": "WAR"
                        },
                        {
                          "text": "Wala na kinahanglan magbiyahe pa sa madamo nga ahensya sang gobyerno",
                          "language": "HIL"
                        },
                        {
                          "text": "Ikkaten ti kasapulan nga agbiahe iti adu nga ahensia ti gobierno",
                          "language": "ILO"
