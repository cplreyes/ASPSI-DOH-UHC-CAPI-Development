            {
              "name": "Q36_QUALITY_CHALL",
              "labels": [
                {
                  "text": "36. What are the major challenges to improving the quality of patient care in your local area?",
                  "language": "EN"
                },
                {
                  "text": "Ano ang mga pangunahing hamon sa pagpapabuti ng kalidad ng pangangalaga sa pasyente sa inyong lokal na lugar?",
                  "language": "FIL"
                },
                {
                  "text": "Ano an mga major na hamon sa pagpapakarhay kan kalidad kan pag-alaga sa pasyente sa saindong lugar?",
                  "language": "BCL"
                },
                {
                  "text": "Unsa ang mga nag-unang hagit sa pagpaayo sa kalidad sa pag-atiman sa pasyente sa inyong lugar?",
                  "language": "BIS"
                },
                {
                  "text": "Unsa ang mga dagkong hagit sa pagpa-uswag sa kalidad sa",
                  "language": "CEB"
                },
                {
                  "text": "Ano an mga dagko nga problema ha pagpauswag han kalidad han pag-ataman han pasyente ha iyo lugar?",
                  "language": "WAR"
                },
                {
                  "text": "Ano ang mga mayor nga problema ukon kabudlayan sa pagpaayo/uswag sang kalidad sang pagatipan sa pasyente sa inyo lokal nga lugar?",
                  "language": "HIL"
                },
                {
                  "text": "Ania dagiti kangrunaan a karit iti panangpasayaat iti kalidad ti panangaywan iti pasiente iti lokal a lugaryo?",
                  "language": "ILO"
                }
              ],
              "contentType": "alpha",
              "length": 20,
              "valueSets": [
