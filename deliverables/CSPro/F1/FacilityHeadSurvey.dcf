                    {
                      "labels": [
                        {
                          "text": "Lack of specific healthcare skills (i.e., Insufficient specialists, surgeons, or other healthcare professionals with specialized skills needed in the facility)",
                          "language": "EN"
                        },
                        {
                          "text": "Kakulangan sa partikular na kasanayan sa pangangalaga sa kalusugan (hal. kulang ang mga espesyalista, surgeon, o ibang propesyonal na may espesyal na kasanayan na kailangan sa pasilidad)",
                          "language": "FIL"
                        },
                        {
                          "text": "Kulang sa specific healthcare skills ( I.e., Kakulangan ki mga espesyalista, surgeons, asin iba pang healthcare professionals na igwa ki specialized skills na kaipuhan kan pasalidad)",
                          "language": "BCL"
                        },
                        {
                          "text": "Kakulangan sa specific healthcare skills o kahanas sa pag-atiman sa panglawas (pananglitan: kakulangan as espesyalista, surgeons ug uban pang mga propesyonal nga adunay kahanas nga gikinanhanglan sa pasilidad)",
                          "language": "BIS"
                        },
                        {
                          "text": "Kakulangan sa specific healthcare skills (I.e. dili paigo ang espesyalista, surgeon, o uban pang healthcare professionals)",
                          "language": "CEB"
                        },
                        {
                          "text": "Kakulang hin partikular nga mga abilidad ha pag-ataman han panlawas (i.e., Kulang nga mga espesyalista, mga siruhano, o iba pa nga mga propesyonal ha pag-ataman han panlawas nga mayda mga espesyalista nga mga abilidad nga ginkikinahanglan ha pasilidad)",
                          "language": "WAR"
                        },
                        {
                          "text": "Kulang sa specific healthcare skills (e.g., kulang sa specialists, surgeons, ukon iban nga professionals nga may espesyal nga abilidad nga kinahanglanon sang pasilidad)",
