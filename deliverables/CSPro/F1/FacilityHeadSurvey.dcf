            {
              "name": "Q160_EXTERNAL_SERVICES_GO",
              "labels": [
                {
                  "text": "160. Where do your patients go to get the services not available at this facility?",
                  "language": "EN"
                },
                {
                  "text": "Saan pumupunta ang inyong mga pasyente upang makuha ang mga serbisyong hindi available sa pasilidad na ito?",
                  "language": "FIL"
                },
                {
                  "text": "Sain nagaduman an saimong pasyente para sa serbisyo na bako available sa pasilidad na ini?",
                  "language": "BCL"
                },
                {
                  "text": "Asa muadto ang inyong mga pasyente aron makakuha sa mga serbisyo nga wala sa maong pasilidad?",
                  "language": "BIS"
                },
                {
                  "text": "Asa moadto ang inyong mga pasyente para makakuha sa mga serbisyo nga dili magamit niini nga pasilidad?",
                  "language": "CEB"
                },
                {
                  "text": "Diin nakadto an iyo mga pasyente para makuha an mga serbisyo nga waray hini nga pasilidad?",
                  "language": "WAR"
                },
                {
                  "text": "Sa diin nagakadto ang inyo mga pasyente agud mabaton ang mga serbisyo nga wala sa inyo nga pasilidad?",
                  "language": "HIL"
                },
                {
