              "valueSets": [
                {
                  "name": "Q33_PHIC_ACCRED_VS1",
                  "labels": [
                    {
                      "text": "33. Does this facility implement PhilHealth accreditation requirements?",
                      "language": "EN"
                    },
                    {
                      "text": "Naipatupad ba ang PhilHealth accreditation requirements mula nang maipasa ang UHC Act noong 2019, at ito ba ay bunga ng UHC Act?",
                      "language": "FIL"
                    },
                    {
                      "text": "An pag implementar ba kan philhealth accreditation requirements puon kan UHC Act na ipinasa kan 2019 asin resulta kan UHC Act?",
                      "language": "BCL"
                    },
                    {
                      "text": "Naimplementar na ba ang PhilHealth accreditation requirements sukad nga naipasa ang UHC Act niadtong 2019, ug kini ba resulta sa maong balaod?",
                      "language": "BIS"
                    },
                    {
                      "text": "Gipatuman ba ang PhilHealth accreditation requirements sukad gipasar ang UHC Act sa 2019 ug tungod ba kini sa UHC Act?",
                      "language": "CEB"
                    },
                    {
                      "text": "Naimplementar na ba an mga kinahanglanon han akreditasyon han PhilHealth tikang han pagpasa han UHC Act hadton 2019 ngan resulta ba ini han UHC Act?",
                      "language": "WAR"
                    },
                    {
                      "text": "Ang PhilHealth accreditation requirements ginpatuman bala umpisa sang pag-aprobar sang UHC Act sang 2019, kag ini bala resulta sang UHC Act?",
                      "language": "HIL"
                    },
                    {
                      "text": "33. Does this facility implement PhilHealth accreditation requirements?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "Yes",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay ipinatupad bilang direktang resulta ng UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, naipatupad na ini, resulta kan UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, napatuman kini tungod sa direkta nga resulta sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, gipatuman kini isip direkta nga resulta sa UHC",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, ini in iginpatuman komo direkta nga resulta han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini ginpatuman bilang direkta nga resulta sang UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, naipatungpal daytoy kas direkta a resulta ti UHC Act",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "1"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "No",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay umiiral na noon ngunit malaki ang naging pagbuti dahil sa UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, dati na ini, pero dakula an pag-improve dahil sa UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, naa na kini daan pero mas napamaayo kini tungod sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, kini anaa na, pero niuswag pag-ayo tungod sa UHC Act",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, naeksister na ini hadto, pero nag-upay gud ini tungod han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini daan nga nag-exist, pero nag-ayo gid tungod sa UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, daytoy ket dati nga adda, ngem dakkel ti simmayaatanna gapu iti UHC Act",
                          "language": "ILO"
                        }
