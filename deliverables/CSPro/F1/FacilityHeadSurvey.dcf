            {
              "name": "Q63_ENROLL_INITIATIVES",
              "labels": [
                {
                  "text": "63. Which of the following initiatives are you doing to enroll patients in this facility to YAKAP/Konsulta?",
                  "language": "EN"
                },
                {
                  "text": "Alin sa mga sumusunod na inisyatiba ang inyong ginagawa upang ma-enroll ang mga pasyente sa pasilidad na ito sa YAKAP/Konsulta?",
                  "language": "FIL"
                },
                {
                  "text": "Arin sa mga minasunod na inisiyatibo tigagibo an pigigibo mo para sa pag-enroll kan pasyente sa pasilidad para sa YAKAP/Konsulta?",
                  "language": "BCL"
                },
                {
                  "text": "Unsa ang inyong ginahimo aron maenroll ang mga pasyente niining pasilidad sa YAKAP/Konsulta?",
                  "language": "BIS"
                },
                {
                  "text": "Asa sa mga musunod nga mga inisyatibo ang inyong gibuhat para ma enrol ang mga pasyente niining pasilidad sa YAKAP/Konsulta?",
                  "language": "CEB"
                },
                {
                  "text": "Hain ha masunod nga mga inisyatibo an iyo ginbubuhat para maenrol an mga pasyente hini nga pasilidad ha YAKAP/Konsulta?",
                  "language": "WAR"
                },
                {
                  "text": "Sa imo ginahimo subong, ano sa mga masunod nga inisyatibo ang ginapatuman sang inyo pasilidad para ma-enroll ang mga pasyente sa YAKAP/Konsulta?",
                  "language": "HIL"
                },
                {
                  "text": "Ania kadagiti sumaganad nga aramid ti ar-aramidem tapno maipalista dagiti pasiente iti daytoy a pasilidad iti YAKAP/Konsulta?)",
                  "language": "ILO"
                }
              ],
