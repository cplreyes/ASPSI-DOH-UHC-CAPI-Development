                  "name": "Q20_EMR_USE_VS1",
                  "labels": [
                    {
                      "text": "20. Have electronic medical records been used in this facility?",
                      "language": "EN"
                    },
                    {
                      "text": "Naipatupad na ba ang paggamit ng electronic medical records sa pasilidad mula nang maipasa ang UHC Act noong 2019, at ito ba ay bunga ng pagpapatupad ng UHC Act?",
                      "language": "FIL"
                    },
                    {
                      "text": "An paggamit kan mga electronic medical record kan pasilidad na ini naimplementa ba manungod sa UHC Act na naipasa kan 2019, ini ba su resulta kan UHC Act?",
                      "language": "BCL"
                    },
                    {
                      "text": "Naimplementar ba ang paggamit sa mga electronic medical records sa pasilidad, sukad nga naimplementar ang UHC Act kaniadtong 2019, ug kini ba resulta sa maong balaod?",
                      "language": "BIS"
                    },
                    {
                      "text": "Napatuman ba ang paggamit ug electronic medical records niini nga health facility sukad napasar ang UHC Act sa 2019 ug resulta ba kini sa UHC ACT?",
                      "language": "CEB"
                    },
                    {
                      "text": "Naimplementar na ba an paggamit han elektronik nga mga medikal nga rekord ha pasilidad tikang han iginpasa an UHC Act dida han 2019 ngan resulta ba ini han UHC Act?",
                      "language": "WAR"
                    },
                    {
                      "text": "Ang paggamit sang electronic medical records sa pasilidad ginpatuman bala umpisa sang pag-aprobar sang UHC Act sang 2019, kag ini bala resulta sang UHC Act?",
                      "language": "HIL"
                    },
                    {
                      "text": "20. Have electronic medical records been used in this facility?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "Yes",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay ipinatupad bilang direktang resulta ng UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, naipatupad na ini, resulta kan UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, napatuman kini tungod sa direkta nga resulta sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, gipatuman kini isip direkta nga resulta sa UHC",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, ini in iginpatuman komo direkta nga resulta han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini ginpatuman bilang direkta nga resulta sang UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, naipatungpal daytoy kas direkta a resulta ti UHC Act",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "1"
                        }
                      ]
                    },
