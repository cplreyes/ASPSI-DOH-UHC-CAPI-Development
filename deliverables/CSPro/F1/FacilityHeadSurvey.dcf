                    {
                      "text": "Ngaa mabudlay ipatuman?",
                      "language": "HIL"
                    },
                    {
                      "text": "Apay a narigat nga ipatungpal daytoy?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "The implementation of UHC benefits is heavily reliant on LGU decisions",
                          "language": "EN"
                        },
                        {
                          "text": "Ang pagpapatupad ng UHC benefits ay lubos na nakasalalay sa mga desisyon ng LGU",
                          "language": "FIL"
                        },
                        {
                          "text": "An pagimplementar kan UHC benefits ay narely sa LGU",
                          "language": "BCL"
                        },
                        {
                          "text": "Ang implementasyon sa UHC nga mga benepisyo nagdepende pag-ayo sa mga desisyon sa LGU",
                          "language": "BIS"
                        },
                        {
                          "text": "Ang pagpatuman sa mga benepisyo sa UHC nagsalig pag-ayo sa mga desisyon sa LGU",
                          "language": "CEB"
                        },
                        {
                          "text": "An pagpatuman han mga benepisyo han UHC in dako an pagdepende ha mga desisyon han LGU.",
                          "language": "WAR"
