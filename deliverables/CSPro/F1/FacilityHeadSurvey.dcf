              "valueSets": [
                {
                  "name": "Q24_1_UHC_ATTRIB_VS1",
                  "labels": [
                    {
                      "text": "24.1. If yes, was it a result of the UHC Act enacted in 2019?",
                      "language": "EN"
                    },
                    {
                      "text": "Naipatupad na ba ang mga pagbabago sa staffing mula nang maipasa ang UHC Act noong 2019, at ito ba ay bunga ng pagpapatupad ng UHC Act?",
                      "language": "FIL"
                    },
                    {
                      "text": "Sa pagbago kan staffing kan pasilidad na ini naimplementa ba manungod sa UHC Act na naipasa kan 2019, ini ba su resulta kan UHC Act?",
                      "language": "BCL"
                    },
                    {
                      "text": "Aduna bay mga kausaban sa staffing sa pasilidad sukad naimplementar ang UHC Act niadtong 2019 ug kini ba resulta sa maong balaod?",
                      "language": "BIS"
                    },
                    {
                      "text": "Napatuman ba ang kausaban sa mga kawani sukad sa napasar ang UHC Act sa 2019 ug resulta ba kini sa UHC Act?",
                      "language": "CEB"
                    },
                    {
                      "text": "Naimplementar na ba an mga pagbabag-o han pag-emplayado tikang han pagpasa han UHC Act dida han 2019 ngan resulta ba ini han UHC Act?",
                      "language": "WAR"
                    },
                    {
                      "text": "Ang mga pagbago sa mga staff sang pasilidad ginpatuman bala umpisa sang pag-aprobar sang UHC Act sang 2019, kag ini bala resulta sang UHC Act?",
                      "language": "HIL"
                    },
                    {
                      "text": "24.1. If yes, was it a result of the UHC Act enacted in 2019?",
                      "language": "ILO"
                    }
                  ],
                  "values": [
                    {
                      "labels": [
                        {
                          "text": "Implemented as a direct result of the UHC Act",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay ipinatupad bilang direktang resulta ng UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, naipatupad na ini, resulta kan UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, napatuman kini tungod sa direkta nga resulta sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, gipatuman kini isip direkta nga resulta sa UHC",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, ini in iginpatuman komo direkta nga resulta han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini ginpatuman bilang direkta nga resulta sang UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, naipatungpal daytoy kas direkta a resulta ti UHC Act",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "1"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "Pre-existing prior to UHC but subsequently enhanced or expanded due to UHC Act",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay umiiral na noon ngunit malaki ang naging pagbuti dahil sa UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, dati na ini, pero dakula an pag-improve dahil sa UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, naa na kini daan pero mas napamaayo kini tungod sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, kini anaa na, pero niuswag pag-ayo tungod sa UHC Act",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, naeksister na ini hadto, pero nag-upay gud ini tungod han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini daan nga nag-exist, pero nag-ayo gid tungod sa UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, daytoy ket dati nga adda, ngem dakkel ti simmayaatanna gapu iti UHC Act",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
                        {
                          "value": "2"
                        }
                      ]
                    },
                    {
                      "labels": [
                        {
                          "text": "Newly implemented or improved independent of UHC Act",
                          "language": "EN"
                        },
                        {
                          "text": "Oo, ito ay ipinatupad o napabuti kamakailan, ngunit hindi dahil sa UHC Act",
                          "language": "FIL"
                        },
                        {
                          "text": "Iyo, may bagong implementasyon sa pag-improve pero bako dahil sa UHC Act",
                          "language": "BCL"
                        },
                        {
                          "text": "Oo, napatuman kini o mas napamaayo, pero dili tungod sa UHC Act",
                          "language": "BIS"
                        },
                        {
                          "text": "Oo, gipatuman na o niuswag, pero dili tungod sa UHC Act",
                          "language": "CEB"
                        },
                        {
                          "text": "Oo, ini in iginpatuman o ginpaupay ha diri pa la maiha, pero diri tungod han UHC Act",
                          "language": "WAR"
                        },
                        {
                          "text": "Huo, ini ginpatuman ukon ginpaayo bag-o lang, pero indi tungod sa UHC Act",
                          "language": "HIL"
                        },
                        {
                          "text": "Wen, naipatungpal wenno napasayaat daytoy itay nabiit, ngem saan a gapu iti UHC Act",
                          "language": "ILO"
                        }
                      ],
                      "pairs": [
