{ ---- Why-difficult display gates (spec 4.10) ---- }
PROC Q122_WHY_DIFF_PT_RIGHTS
preproc
  numeric wdN; numeric wdK; numeric wdP; numeric wdHit;
  wdHit = 0;
  wdN = length(strip(Q121_DOH_LIC_DIFFICULT)) / 2;
  do wdK = 1 while wdK <= wdN
    wdP = (wdK - 1) * 2 + 1;
    if tonumber(Q121_DOH_LIC_DIFFICULT[wdP:2]) = 1 then wdHit = 1; endif;
  enddo;
  if wdHit = 0 then   { Q122 shown only if Q121 difficulty option 01 ticked }
    skip to Q123_WHY_DIFF_PT_CARE;
  endif;
postproc
  if length(strip(Q122_WHY_DIFF_PT_RIGHTS)) = 0 then
    errmsg(1106);
    reenter;
  endif;

