    errmsg(1068);
  endif;
  { #526 exclusivity (soft warn): 'All of the above' (08) implies every item — it should stand alone }
  if pos("08", Q53_YK_PACKAGE) > 0 and length(strip(Q53_YK_PACKAGE)) > 2 then
