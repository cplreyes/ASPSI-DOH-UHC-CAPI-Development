{ ---- Why-difficult display gates (spec 4.10) ---- }
PROC Q109_WHY_DIFF_PT_RIGHTS
preproc
  numeric wdN; numeric wdK; numeric wdP; numeric wdHit;
  wdHit = 0;
  wdN = length(strip(Q108_DOH_LIC_DIFFICULT)) / 2;
  do wdK = 1 while wdK <= wdN
    wdP = (wdK - 1) * 2 + 1;
    if tonumber(Q108_DOH_LIC_DIFFICULT[wdP:2]) = 1 then wdHit = 1; endif;
  enddo;
  if wdHit = 0 then   { Q109 shown only if Q108 difficulty option 01 ticked }
    skip to Q110_WHY_DIFF_PT_CARE;
  endif;
postproc
  if length(strip(Q109_WHY_DIFF_PT_RIGHTS)) = 0 then
    errmsg(1298);
    reenter;
  endif;

PROC Q109_WHY_DIFF_PT_RIGHTS_OTHER_TXT
preproc
  if pos("99", Q109_WHY_DIFF_PT_RIGHTS) = 0 then
    Q109_WHY_DIFF_PT_RIGHTS_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked }
    noinput;
  endif;
postproc
  if pos("99", Q109_WHY_DIFF_PT_RIGHTS) > 0 and length(strip(Q109_WHY_DIFF_PT_RIGHTS_OTHER_TXT)) = 0 then
    errmsg(1299);
    reenter;
  endif;

PROC Q110_WHY_DIFF_PT_CARE
preproc
  numeric wdN; numeric wdK; numeric wdP; numeric wdHit;
  wdHit = 0;
  wdN = length(strip(Q108_DOH_LIC_DIFFICULT)) / 2;
  do wdK = 1 while wdK <= wdN
    wdP = (wdK - 1) * 2 + 1;
    if tonumber(Q108_DOH_LIC_DIFFICULT[wdP:2]) = 2 then wdHit = 1; endif;
  enddo;
  if wdHit = 0 then   { Q110 shown only if Q108 difficulty option 02 ticked }
    skip to Q111_WHY_DIFF_LEADERSHIP;
  endif;
postproc
  if length(strip(Q110_WHY_DIFF_PT_CARE)) = 0 then
    errmsg(1300);
    reenter;
  endif;

PROC Q110_WHY_DIFF_PT_CARE_OTHER_TXT
preproc
  if pos("99", Q110_WHY_DIFF_PT_CARE) = 0 then
    Q110_WHY_DIFF_PT_CARE_OTHER_TXT = "";   { gated: 'Other (specify)' not ticked }
    noinput;
  endif;
postproc
  if pos("99", Q110_WHY_DIFF_PT_CARE) > 0 and length(strip(Q110_WHY_DIFF_PT_CARE_OTHER_TXT)) = 0 then
    errmsg(1301);
    reenter;
  endif;

PROC Q111_WHY_DIFF_LEADERSHIP
preproc
  numeric wdN; numeric wdK; numeric wdP; numeric wdHit;
  wdHit = 0;
  wdN = length(strip(Q108_DOH_LIC_DIFFICULT)) / 2;
