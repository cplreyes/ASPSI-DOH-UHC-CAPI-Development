    skip to Q112_STOCKOUT;
  endif;
  { Other (5) -> fall through to Q110_OTHER_TXT }

PROC Q110_OTHER_TXT
postproc
  if length(strip(Q110_OTHER_TXT)) = 0 then
    errmsg(1204);
    reenter;
