    skip to Q135_NBB_CURR;
  endif;

{ ---- Numeric-range validations (spec section 3) ---- }
PROC Q3_AGE
postproc
  if Q3_AGE < 18 or Q3_AGE > 90 then
    errmsg("Facility head age must be between 18 and 90.");
    reenter;
  endif;
  if Q3_AGE > 75 then
    if accept(maketext("Age %d is unusually old for an active facility head. Confirm?", Q3_AGE), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q57_CAPITATION_AMT
postproc
  if Q57_CAPITATION_AMT > 5000 then
    errmsg("Capitation %d PHP is implausibly high. Reenter.", Q57_CAPITATION_AMT);
    reenter;
  endif;
  if Q57_CAPITATION_AMT > 1700 then
    if accept(maketext("Capitation %d exceeds the PHP 1,700 PhilHealth max. Confirm?", Q57_CAPITATION_AMT), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q91_MIN_CAP_VALUE_ACC
postproc
  if Q91_MIN_CAP_VALUE_ACC > 50000 then
    errmsg("Minimum acceptable capitation %d PHP is implausibly high. Reenter.", Q91_MIN_CAP_VALUE_ACC);
    reenter;
  endif;
  if Q91_MIN_CAP_VALUE_ACC > 5000 then
    if accept(maketext("Minimum acceptable capitation %d PHP is high. Confirm?", Q91_MIN_CAP_VALUE_ACC), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q92_MIN_CAP_VALUE_NONACC
postproc
  if Q92_MIN_CAP_VALUE_NONACC > 50000 then
    errmsg("Minimum acceptable capitation %d PHP is implausibly high. Reenter.", Q92_MIN_CAP_VALUE_NONACC);
    reenter;
  endif;
  if Q92_MIN_CAP_VALUE_NONACC > 5000 then
    if accept(maketext("Minimum acceptable capitation %d PHP is high. Confirm?", Q92_MIN_CAP_VALUE_NONACC), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q154_NUM_REFERRED_OUT
postproc
  if Q154_NUM_REFERRED_OUT > 100000 then
    errmsg("Referrals out (%d) over 6 months is implausibly high. Reenter.", Q154_NUM_REFERRED_OUT);
    reenter;
  endif;
  if Q154_NUM_REFERRED_OUT > 10000 then
    if accept(maketext("Referrals out (%d) over 6 months is high. Confirm?", Q154_NUM_REFERRED_OUT), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q52_YK_SINCE_YEAR
postproc
  if Q52_YK_SINCE_YEAR < 2019 or Q52_YK_SINCE_YEAR > currentYear then
    errmsg("YAKAP accreditation year must be between 2019 and %d.", currentYear);
    reenter;
  endif;

PROC Q52_YK_SINCE_MONTH
postproc
  if Q52_YK_SINCE_MONTH < 1 or Q52_YK_SINCE_MONTH > 12 then
    errmsg("Month must be 1-12.");
    reenter;
  endif;
  if Q52_YK_SINCE_YEAR = currentYear and Q52_YK_SINCE_MONTH > currentMonth then
    errmsg("Accreditation date is in the future. Reenter.");
    reenter;
  endif;

PROC Q87_REGISTERED_PATIENTS
postproc
  if Q87_REGISTERED_PATIENTS > Q86_ELIGIBLE_PATIENTS then
    errmsg("Registered patients (%d) cannot exceed eligible patients (%d).",
           Q87_REGISTERED_PATIENTS, Q86_ELIGIBLE_PATIENTS);
    reenter;
  endif;

