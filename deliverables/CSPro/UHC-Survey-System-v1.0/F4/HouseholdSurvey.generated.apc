{ ---- Numeric-range validations (spec section 3) ---- }
PROC Q2_BIRTH_MONTH
postproc
  if Q2_BIRTH_MONTH < 1 or Q2_BIRTH_MONTH > 12 then
    errmsg("Birth month must be 1-12.");
    reenter;
  endif;

PROC Q19_HH_SIZE_TOTAL
postproc
  if Q19_HH_SIZE_TOTAL < 1 or Q19_HH_SIZE_TOTAL > 20 then
    errmsg("Household size must be between 1 and 20.");
    reenter;
  endif;
  if Q19_HH_SIZE_TOTAL > 10 then
    if accept(maketext("Household size %d is unusually large. Confirm?", Q19_HH_SIZE_TOTAL), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q32_AGE
postproc
