      Q178_PREVENTIVE_PURCHASED_PHP + Q178_PREVENTIVE_INKIND_PHP + Q179_DIAGNOSTIC_PURCHASED_PHP + Q179_DIAGNOSTIC_INKIND_PHP +
      Q180_ASSISTIVE_PURCHASED_PHP + Q180_ASSISTIVE_INKIND_PHP + Q181_MEDICAL_PRODUCTS_PURCHASED_PHP + Q181_MEDICAL_PRODUCTS_INKIND_PHP;
