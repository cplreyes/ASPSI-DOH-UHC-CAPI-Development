{ ============================================================
  PatientSurvey.generated.apc — F3 CAPI logic (v1.0, phase 4)

  GENERATED by F3/generate_apc.py — do NOT hand-edit.
  Patch the generator + F3-Skip-Logic-and-Validations.md, then
  regenerate. Verified against a paper walkthrough in the
  bench-test pass (spec section 6.5).
  ============================================================ }

{ ---- shared helper includes (spec 4.3, 4.3a) ---- }
#include "../../shared/PSGC-Cascade.apc"
#include "../../shared/Capture-Helpers.apc"

PROC GLOBAL
numeric currentYYYYMMDD;
numeric currentYear;
numeric currentMonth;

PROC PATIENTSURVEY_FF
preproc
  currentYYYYMMDD = tonumber(sysdate("YYYYMMDD"));
  currentYear  = int(currentYYYYMMDD / 10000);
  currentMonth = int(currentYYYYMMDD / 100) % 100;

PROC FIELD_CONTROL
preproc
  { prefill the case-control block on first visit (spec 4.16) }
  if visualvalue(SURVEY_CODE) = "" then
    SURVEY_CODE       = "F3";
    DATE_STARTED      = tonumber(sysdate("YYYYMMDD"));
    TIME_STARTED      = tonumber(systime("HHMMSS"));
    AAPOR_DISPOSITION = 0;   { 000 = In Progress }
  endif;

PROC CONSENT_GIVEN
postproc
  { consent refusal -> AAPOR 210, skip all data entry to the closing form }
  if CONSENT_GIVEN = 2 then
    AAPOR_DISPOSITION       = 210;   { Refusal — respondent }
    ENUM_RESULT_FINAL_VISIT = 3;     { Refused }
    errmsg("Consent not given. Close the questionnaire and code as Refused.");
    skip to SURVEY_TEAM_LEADER_S_NAME;   { first item on the closing form }
  endif;

PROC F_HEALTH_SEEKING
postproc
  { route to Section G (outpatient) or H (inpatient) — PATIENT_TYPE is
    the authoritative signal }
  if PATIENT_TYPE = 1 then
    skip to G_OUTPATIENT_CARE;
  elseif PATIENT_TYPE = 2 then
    skip to H_INPATIENT_CARE;
  else
    errmsg("PATIENT_TYPE missing — set it in Field Control before advancing.");
    reenter;
  endif;

PROC G_OUTPATIENT_CARE
preproc
  if PATIENT_TYPE <> 1 then skip to I_FINANCIAL_RISK; endif;

PROC H_INPATIENT_CARE
preproc
  if PATIENT_TYPE <> 2 then skip to I_FINANCIAL_RISK; endif;

PROC Q113_PAY_07
postproc
  { if MAIFIP was already in the payment list, pre-answer Q124 awareness }
  if Q113_PAY_07 = 1 then
    Q124_MAIFIP_HEARD = 1;
  endif;

PROC Q170_FOLLOWUP
postproc
  skip to Q172_PCP_REFERRAL;   { explicit — Q171 is the not-visited branch }

PROC Q162_REFERRED
postproc
  { no referral -> survey complete, skip Q163-Q178 }
  if Q162_REFERRED = 2 then
    AAPOR_DISPOSITION       = 110;   { Complete interview }
    ENUM_RESULT_FINAL_VISIT = 1;     { Completed }
    skip to SURVEY_TEAM_LEADER_S_NAME;
  endif;

PROC Q178_SAT_REFERRAL
postproc
  { end of Section L — mark the case complete }
  AAPOR_DISPOSITION       = 110;
  ENUM_RESULT_FINAL_VISIT = 1;

{ ---- PSGC cascade (spec 4.3) ---- }
PROC PROVINCE_HUC_CODE
onfocus
  FillProvinceValueSet(PROVINCE_HUC_CODE, REGION_CODE);

PROC CITY_MUNICIPALITY_CODE
onfocus
  FillCityValueSet(CITY_MUNICIPALITY_CODE, PROVINCE_HUC_CODE);

PROC BARANGAY_CODE
onfocus
  FillBarangayValueSet(BARANGAY_CODE, CITY_MUNICIPALITY_CODE);

PROC P_PROVINCE_HUC_CODE
onfocus
  FillProvinceValueSet(P_PROVINCE_HUC_CODE, P_REGION_CODE);

PROC P_CITY_MUNICIPALITY_CODE
onfocus
  FillCityValueSet(P_CITY_MUNICIPALITY_CODE, P_PROVINCE_HUC_CODE);

PROC P_BARANGAY_CODE
onfocus
  FillBarangayValueSet(P_BARANGAY_CODE, P_CITY_MUNICIPALITY_CODE);

{ ---- GPS + verification photo capture (spec 4.3a) ---- }
PROC FACILITY_CAPTURE_GPS
onfocus
  if ReadGPSReading(120, 20) then
    FACILITY_GPS_LATITUDE   = maketext("%f", gps(latitude));
    FACILITY_GPS_LONGITUDE  = maketext("%f", gps(longitude));
    FACILITY_GPS_ALTITUDE   = maketext("%f", gps(altitude));
    FACILITY_GPS_ACCURACY   = gps(accuracy);
    FACILITY_GPS_SATELLITES = gps(satellites);
    FACILITY_GPS_READTIME   = gps(readtime);
  endif;
  FACILITY_CAPTURE_GPS = notappl;   { re-arm the trigger }

PROC P_HOME_CAPTURE_GPS
onfocus
  if ReadGPSReading(120, 20) then
    P_HOME_GPS_LATITUDE   = maketext("%f", gps(latitude));
    P_HOME_GPS_LONGITUDE  = maketext("%f", gps(longitude));
    P_HOME_GPS_ALTITUDE   = maketext("%f", gps(altitude));
    P_HOME_GPS_ACCURACY   = gps(accuracy);
    P_HOME_GPS_SATELLITES = gps(satellites);
    P_HOME_GPS_READTIME   = gps(readtime);
  endif;
  P_HOME_CAPTURE_GPS = notappl;   { re-arm the trigger }

PROC FACILITY_GPS_LATITUDE
postproc
  numeric lat;
  lat = tonumber(FACILITY_GPS_LATITUDE);
  if lat <> notappl and (lat < 4.5 or lat > 21.5) then
    errmsg("Latitude %f is outside the Philippine bounding box — re-capture.", lat);
    move to FACILITY_CAPTURE_GPS;
  endif;

PROC FACILITY_GPS_LONGITUDE
postproc
  numeric lon;
  lon = tonumber(FACILITY_GPS_LONGITUDE);
  if lon <> notappl and (lon < 116.5 or lon > 127.0) then
    errmsg("Longitude %f is outside the Philippine bounding box — re-capture.", lon);
    move to FACILITY_CAPTURE_GPS;
  endif;

PROC FACILITY_GPS_ACCURACY
postproc
  if FACILITY_GPS_ACCURACY <> notappl and FACILITY_GPS_ACCURACY > 30 then
    errmsg("GPS accuracy %d m is poor (> 30 m). Re-read outdoors recommended.", FACILITY_GPS_ACCURACY);
  endif;

PROC FACILITY_GPS_SATELLITES
postproc
  if FACILITY_GPS_SATELLITES <> notappl and FACILITY_GPS_SATELLITES < 4 then
    errmsg("Only %d GPS satellites — fix below the reliable minimum.", FACILITY_GPS_SATELLITES);
  endif;

PROC P_HOME_GPS_LATITUDE
postproc
  numeric lat;
  lat = tonumber(P_HOME_GPS_LATITUDE);
  if lat <> notappl and (lat < 4.5 or lat > 21.5) then
    errmsg("Latitude %f is outside the Philippine bounding box — re-capture.", lat);
    move to P_HOME_CAPTURE_GPS;
  endif;

PROC P_HOME_GPS_LONGITUDE
postproc
  numeric lon;
  lon = tonumber(P_HOME_GPS_LONGITUDE);
  if lon <> notappl and (lon < 116.5 or lon > 127.0) then
    errmsg("Longitude %f is outside the Philippine bounding box — re-capture.", lon);
    move to P_HOME_CAPTURE_GPS;
  endif;

PROC P_HOME_GPS_ACCURACY
postproc
  if P_HOME_GPS_ACCURACY <> notappl and P_HOME_GPS_ACCURACY > 30 then
    errmsg("GPS accuracy %d m is poor (> 30 m). Re-read outdoors recommended.", P_HOME_GPS_ACCURACY);
  endif;

PROC P_HOME_GPS_SATELLITES
postproc
  if P_HOME_GPS_SATELLITES <> notappl and P_HOME_GPS_SATELLITES < 4 then
    errmsg("Only %d GPS satellites — fix below the reliable minimum.", P_HOME_GPS_SATELLITES);
  endif;

PROC CAPTURE_VERIFICATION_PHOTO
onfocus
  string fn;
  fn = "case-" + maketext("%02d%02d%03d%02d%03d", REGION_CODE, PROVINCE_HUC_CODE,
            CITY_MUNICIPALITY_CODE, FACILITY_NO, CASE_SEQ) + "-verification.jpg";
  if TakeVerificationPhoto(fn) then
    VERIFICATION_PHOTO_FILENAME = fn;
  endif;
  CAPTURE_VERIFICATION_PHOTO = notappl;

PROC VERIFICATION_PHOTO_FILENAME
postproc
  if ENUM_RESULT_FINAL_VISIT = 1 and length(strip(VERIFICATION_PHOTO_FILENAME)) = 0 then
    errmsg("Verification photo is required when the case is marked Completed.");
    move to CAPTURE_VERIFICATION_PHOTO;
  endif;

{ ---- Section B — cross-field consistency (spec 4.6, 4.7) ---- }
PROC Q6_AGE
postproc
  if Q6_AGE < 0 or Q6_AGE > 120 then
    errmsg("Patient age must be between 0 and 120.");
    reenter;
  endif;
  { age vs birth-year consistency (allow +/-1 for not-yet-birthday) }
  if Q5_BIRTH_YEAR > 0 and
     abs((currentYear - Q5_BIRTH_YEAR) - Q6_AGE) > 1 then
    errmsg("Age %d is inconsistent with birth year %d.", Q6_AGE, Q5_BIRTH_YEAR);
    reenter;
  endif;

PROC Q5_BIRTH_YEAR
postproc
  if Q5_BIRTH_YEAR < 1900 or Q5_BIRTH_YEAR > currentYear then
    errmsg("Birth year must be between 1900 and %d.", currentYear);
    reenter;
  endif;

PROC Q18_INCOME_BRACKET
postproc
  { amount must fall inside the chosen bracket (spec 4.6) }
  numeric lo; numeric hi;
  if     Q18_INCOME_BRACKET = 1 then lo =      0; hi =    39999;
  elseif Q18_INCOME_BRACKET = 2 then lo =  40000; hi =    59999;
  elseif Q18_INCOME_BRACKET = 3 then lo =  60000; hi =    99999;
  elseif Q18_INCOME_BRACKET = 4 then lo = 100000; hi =   249999;
  elseif Q18_INCOME_BRACKET = 5 then lo = 250000; hi =   499999;
  elseif Q18_INCOME_BRACKET = 6 then lo = 500000; hi = 99999999;
  endif;
  if Q18_INCOME_AMOUNT < lo or Q18_INCOME_AMOUNT > hi then
    errmsg("Amount %d is outside bracket %d (%d-%d). Reenter amount or bracket.",
           Q18_INCOME_AMOUNT, Q18_INCOME_BRACKET, lo, hi);
    reenter;
  endif;

PROC Q21_HH_SENIORS
postproc
  { household composition invariant (spec 4.7) }
  if (Q20_HH_CHILDREN + Q21_HH_SENIORS) > Q19_HH_SIZE then
    errmsg("Children (%d) + Seniors (%d) exceed total HH size (%d).",
           Q20_HH_CHILDREN, Q21_HH_SENIORS, Q19_HH_SIZE);
    reenter;
  endif;

{ ---- Skip logic (spec section 2) ---- }
PROC Q1_IS_PATIENT
postproc
  { respondent IS the patient -> skip Q2, Q3 }
  if Q1_IS_PATIENT = 1 then
    skip to Q4_NAME;
  endif;

PROC Q11_PWD
postproc
  { Q11 = No -> skip Q12-Q14 }
  if Q11_PWD = 2 then
    skip to Q15_EDUCATION;
  endif;

PROC Q12_PWD_SPECIFY
postproc
  { Q12 = No -> skip Q13, Q14 }
  if Q12_PWD_SPECIFY = 2 then
    skip to Q15_EDUCATION;
  endif;

PROC Q30_IP
postproc
  { Q30 = No -> skip Q31 }
  if Q30_IP = 2 then
    skip to Q32_4PS;
  endif;

PROC Q33_DECISION_MAKER
postproc
  { Q33 = patient/companion is decision-maker -> skip Q34 }
  if Q33_DECISION_MAKER in 1,3 then
    skip to Q35_UHC_HEARD;
  endif;

PROC Q35_UHC_HEARD
postproc
  { Q35 = No -> skip Q36, Q37 }
  if Q35_UHC_HEARD = 2 then
    skip to Q38_PHILHEALTH_REG;
  endif;

PROC Q38_PHILHEALTH_REG
postproc
  { Q38 = non-member -> skip Q39-Q42 }
  if Q38_PHILHEALTH_REG in 2,3 then
    skip to Q43_KNOWS_ASSIST;
  endif;

PROC Q41_REG_DIFFICULTY
postproc
  { Q41 = No -> skip Q42 }
  if Q41_REG_DIFFICULTY = 2 then
    skip to Q43_KNOWS_ASSIST;
  endif;

PROC Q43_KNOWS_ASSIST
postproc
  { Q43 = No -> skip Q44 }
  if Q43_KNOWS_ASSIST = 2 then
    skip to Q45_CATEGORY;
  endif;

PROC Q48_PREMIUM_PAY
postproc
  { Q48 = does not pay premiums -> skip Q49, Q50 }
  if Q48_PREMIUM_PAY = 3 then
    skip to Q51_OTHER_INSURANCE;
  endif;

PROC Q49_PREMIUM_DIFFICULT
postproc
  { Q49 = No -> skip Q50 }
  if Q49_PREMIUM_DIFFICULT = 2 then
    skip to Q51_OTHER_INSURANCE;
  endif;

PROC Q51_OTHER_INSURANCE
postproc
  { Q51 = No -> skip Q52 }
  if Q51_OTHER_INSURANCE = 2 then
    skip to Q53_HAS_PCP;
  endif;

PROC Q53_HAS_PCP
postproc
  { Q53 = No PCP -> skip Q54-Q62 }
  if Q53_HAS_PCP = 2 then
    skip to Q63_HAS_USUAL_FACILITY;
  endif;

PROC Q66_SAME_AS_USUAL
postproc
  { Q66 = Yes (this is the usual facility) -> skip Q67 }
  if Q66_SAME_AS_USUAL = 1 then
    skip to Q68_USUAL_FAC_TYPE;
  endif;

PROC Q74_KON_HEARD
postproc
  { Q74 = No -> skip Q75-Q82 (exit Section E) }
  if Q74_KON_HEARD = 2 then
    skip to Q83_VISIT_REASON;
  endif;

PROC Q93_LABS_O17
postproc
  { Q93 = None -> skip Q94 lab-cost matrix }
  if Q93_LABS_O17 = 1 then
    skip to Q95_PRESCRIBED;
  endif;

PROC Q95_PRESCRIBED
postproc
  { Q95 = No -> skip Q96 meds-cost matrix }
  if Q95_PRESCRIBED = 2 then
    skip to Q97_FINAL_AMOUNT;
  endif;

PROC Q99_BUCAS_HEARD
postproc
  { Q99 = No -> skip Q100-Q104 (end of Section G; spec sanity #9 default) }
  if Q99_BUCAS_HEARD = 2 then
    skip to Q105_REASON;
  endif;

PROC Q102_BUCAS_ACCESSED
postproc
  { Q102 = No -> skip Q103 }
  if Q102_BUCAS_ACCESSED = 2 then
    skip to Q104_WITHOUT_BUCAS;
  endif;

PROC Q108_MEDS_OUTSIDE
postproc
  { Q108 = No -> skip Q109 meds-outside matrix }
  if Q108_MEDS_OUTSIDE = 2 then
    skip to Q110_LAB_OUTSIDE;
  endif;

PROC Q110_LAB_OUTSIDE
postproc
  { Q110 = No -> skip Q111, Q112 }
  if Q110_LAB_OUTSIDE = 2 then
    skip to Q113_PAY_01;
  endif;

PROC Q116_NBB_HEARD
postproc
  { Q116 not heard -> skip Q117, Q118 }
  if Q116_NBB_HEARD in 2,3 then
    skip to Q119_ZBB_HEARD;
  endif;

PROC Q119_ZBB_HEARD
postproc
  { Q119 not heard -> skip Q120-Q123 }
  if Q119_ZBB_HEARD in 2,3 then
    skip to Q124_MAIFIP_HEARD;
  endif;

PROC Q124_MAIFIP_HEARD
postproc
  { Q124 not heard -> skip Q125-Q129 }
  if Q124_MAIFIP_HEARD in 2,3 then
    skip to Q130_REDUCED_SPEND;
  endif;

PROC Q126_MAIFIP_AVAILED
postproc
  { Q126 = No -> skip Q127, Q128 }
  if Q126_MAIFIP_AVAILED = 2 then
    skip to Q129_WHY_NO_MAIFIP_O01;
  endif;

PROC Q127_MAIFIP_OOP
postproc
  { Q127 = No -> skip Q128, Q129 }
  if Q127_MAIFIP_OOP = 2 then
    skip to Q130_REDUCED_SPEND;
  endif;

PROC Q145_PURCHASE_FREQ
postproc
  { Q145 = Never -> skip Q146-Q151 }
  if Q145_PURCHASE_FREQ = 5 then
    skip to Q152_GAMOT_HEARD;
  endif;

PROC Q152_GAMOT_HEARD
postproc
  { Q152 = No -> skip Q153-Q157 }
  if Q152_GAMOT_HEARD = 2 then
    skip to Q158_BRAND_GEN_KNOW;
  endif;

PROC Q158_BRAND_GEN_KNOW
postproc
  { Q158 = No -> exit Section K }
  if Q158_BRAND_GEN_KNOW = 2 then
    skip to Q162_REFERRED;
  endif;

PROC Q169_VISITED
postproc
  { Q169 = not planning / not yet -> skip Q170 }
  if Q169_VISITED in 2,3 then
    skip to Q171_WHY_NOT_O01;
  endif;

PROC Q172_PCP_REFERRAL
postproc
  { Q172 = No -> skip Q173-Q176 }
  if Q172_PCP_REFERRAL = 2 then
    skip to Q177_WHY_HOSPITAL_O01;
  endif;

{ ---- Multi-branch skip routing (spec section 2) ---- }
PROC Q63_HAS_USUAL_FACILITY
postproc
  { Q63 usual-facility branch: No -> Q65 (skip Q64); Yes -> Q66 (skip Q65) }
  if Q63_HAS_USUAL_FACILITY = 2 then
    skip to Q65_WHY_NO_USUAL_O01;
  endif;
  if Q63_HAS_USUAL_FACILITY = 1 then
    skip to Q66_SAME_AS_USUAL;
  endif;

PROC Q77_KON_REGISTERED
postproc
  { Q77 YAKAP-registration branch: No -> Q82; never-heard/IDK -> Q83 }
  if Q77_KON_REGISTERED = 2 then
    skip to Q82_KON_WHY_NOT_REG_O01;
  endif;
  if Q77_KON_REGISTERED in 3,4 then
    skip to Q83_VISIT_REASON;
  endif;

PROC Q159_BRAND_GEN_BOUGHT
postproc
  { Q159 branded/generic branch; = 5 (Not applicable) is a cross-section jump to Q164 per spec sanity #7 -- confirm with ASPSI }
  if Q159_BRAND_GEN_BOUGHT = 1 then
    skip to Q161_WHY_BRANDED_O01;
  endif;
  if Q159_BRAND_GEN_BOUGHT = 4 then
    skip to Q162_REFERRED;
  endif;
  if Q159_BRAND_GEN_BOUGHT = 5 then
    skip to Q164_SPECIALIST;
  endif;

{ ---- Branch block gates (spec section 3) ---- }
PROC Q45_CATEGORY
preproc
  { Q45-Q50 (member category / benefits / premiums) only for PhilHealth members }
  if Q38_PHILHEALTH_REG <> 1 then
    skip to Q51_OTHER_INSURANCE;
  endif;

{ ---- Numeric-range validations (spec section 3) ---- }
PROC Q5_BIRTH_MONTH
postproc
  if Q5_BIRTH_MONTH < 1 or Q5_BIRTH_MONTH > 12 then
    errmsg("Birth month must be 1-12.");
    reenter;
  endif;

PROC Q19_HH_SIZE
postproc
  if Q19_HH_SIZE < 1 or Q19_HH_SIZE > 30 then
    errmsg("Household size must be between 1 and 30.");
    reenter;
  endif;
  if Q19_HH_SIZE > 15 then
    if accept(maketext("Household size %d is unusually large. Confirm?", Q19_HH_SIZE), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q58_WAIT_DAYS
postproc
  if Q58_WAIT_DAYS < 0 or Q58_WAIT_DAYS > 365 then
    errmsg("Wait days must be between 0 and 365.");
    reenter;
  endif;

PROC Q58_WAIT_MINUTES
postproc
  if Q58_WAIT_MINUTES < 0 or Q58_WAIT_MINUTES > 1440 then
    errmsg("Wait minutes must be between 0 and 1440.");
    reenter;
  endif;

PROC Q69_USUAL_TRAVEL_MM
postproc
  if Q69_USUAL_TRAVEL_MM < 0 or Q69_USUAL_TRAVEL_MM > 59 then
    errmsg("Minutes must be between 0 and 59.");
    reenter;
  endif;

PROC Q72_NEAREST_TRAVEL_MM
postproc
  if Q72_NEAREST_TRAVEL_MM < 0 or Q72_NEAREST_TRAVEL_MM > 59 then
    errmsg("Minutes must be between 0 and 59.");
    reenter;
  endif;

PROC Q150_TRAVEL_MM
postproc
  if Q150_TRAVEL_MM < 0 or Q150_TRAVEL_MM > 59 then
    errmsg("Minutes must be between 0 and 59.");
    reenter;
  endif;

PROC Q106_NIGHTS
postproc
  if Q106_NIGHTS < 0 or Q106_NIGHTS > 365 then
    errmsg("Confinement nights must be between 0 and 365.");
    reenter;
  endif;
  if Q106_NIGHTS > 90 then
    if accept(maketext("Confinement of %d nights is unusually long. Confirm?", Q106_NIGHTS), "Yes", "No") <> 1 then
      reenter;
    endif;
  endif;

PROC Q106_DAYS
postproc
  if Q106_DAYS < 0 or Q106_DAYS > 365 then
    errmsg("Confinement days must be between 0 and 365.");
    reenter;
  endif;

{ ---- Payment-source matrix flag<->amount rules (spec 4.10) ---- }
PROC Q107_PAY_01_AMT
postproc
  if Q107_PAY_01 = 1 and Q107_PAY_01_AMT <= 0 then
    errmsg("Q107_PAY_01 flagged but amount is 0 — enter a positive peso amount.");
    reenter;
  endif;
  if Q107_PAY_01 = 2 and Q107_PAY_01_AMT > 0 then
    errmsg("Amount entered for an unused payment source — clear it or flag the source.");
    reenter;
  endif;

PROC Q107_PAY_02_AMT
postproc
  if Q107_PAY_02 = 1 and Q107_PAY_02_AMT <= 0 then
    errmsg("Q107_PAY_02 flagged but amount is 0 — enter a positive peso amount.");
    reenter;
  endif;
  if Q107_PAY_02 = 2 and Q107_PAY_02_AMT > 0 then
    errmsg("Amount entered for an unused payment source — clear it or flag the source.");
    reenter;
  endif;

PROC Q107_PAY_03_AMT
postproc
  if Q107_PAY_03 = 1 and Q107_PAY_03_AMT <= 0 then
    errmsg("Q107_PAY_03 flagged but amount is 0 — enter a positive peso amount.");
    reenter;
  endif;
  if Q107_PAY_03 = 2 and Q107_PAY_03_AMT > 0 then
    errmsg("Amount entered for an unused payment source — clear it or flag the source.");
    reenter;
  endif;

PROC Q107_PAY_04_AMT
postproc
  if Q107_PAY_04 = 1 and Q107_PAY_04_AMT <= 0 then
    errmsg("Q107_PAY_04 flagged but amount is 0 — enter a positive peso amount.");
    reenter;
  endif;
  if Q107_PAY_04 = 2 and Q107_PAY_04_AMT > 0 then
    errmsg("Amount entered for an unused payment source — clear it or flag the source.");
    reenter;
  endif;

PROC Q107_PAY_05_AMT
