    {
      "type": "text", "id": "s4_13t", "x": 1376, "y": 1300, "width": 390, "height": 90,
      "text": "★ Already specced:\nE9-ADMIN-046, the\n/docs/idp/svc/f2/* endpoints\nthat FORK-2 row 1 needs.\nPost-pretest by design.",
      "originalText": "★ Already specced:\nE9-ADMIN-046, the\n/docs/idp/svc/f2/* endpoints\nthat FORK-2 row 1 needs.\nPost-pretest by design.",
