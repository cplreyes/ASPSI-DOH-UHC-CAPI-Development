    {
      "type": "text", "id": "s5_t", "x": 88, "y": 1622, "width": 1780, "height": 96,
      "text": "RECOMMENDATION —  Option A,  F2 by proxy,  CSWeb by link.",
      "originalText": "RECOMMENDATION —  Option A,  F2 by proxy,  CSWeb by link.",
      "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
