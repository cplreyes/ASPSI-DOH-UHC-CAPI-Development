    },
    {
      "type": "text", "id": "s5_t2", "x": 88, "y": 1656, "width": 1780, "height": 72,
      "text": "One portal_shell.py, imported everywhere.  /projects/uhc-y2/{monitoring, map, data, tabulations, admin}/ ARE the live pages; /docs/* becomes 301s.\nThe two signpost pages are deleted, not redirected.  F2 admin mounts under the portal after pretest.  CSWeb keeps its own door — vendor code, frozen sync.",
      "originalText": "One portal_shell.py, imported everywhere.  /projects/uhc-y2/{monitoring, map, data, tabulations, admin}/ ARE the live pages; /docs/* becomes 301s.\nThe two signpost pages are deleted, not redirected.  F2 admin mounts under the portal after pretest.  CSWeb keeps its own door — vendor code, frozen sync.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
