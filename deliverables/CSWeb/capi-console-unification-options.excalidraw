    {
      "type": "text", "id": "s4_12t", "x": 936, "y": 1300, "width": 390, "height": 90,
      "text": "★ Mount at\n/projects/uhc-y2/f2-admin/\nSame origin, portal chrome\nwraps it. The Worker is yours,\nso its links are relative.",
      "originalText": "★ Mount at\n/projects/uhc-y2/f2-admin/\nSame origin, portal chrome\nwraps it. The Worker is yours,\nso its links are relative.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
