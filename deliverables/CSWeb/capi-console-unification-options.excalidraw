    {
      "type": "text", "id": "s4_11t", "x": 496, "y": 1300, "width": 390, "height": 90,
      "text": "Works today.\nSecond login, different look.\nZero risk — and zero\nprogress.",
      "originalText": "Works today.\nSecond login, different look.\nZero risk — and zero\nprogress.",
