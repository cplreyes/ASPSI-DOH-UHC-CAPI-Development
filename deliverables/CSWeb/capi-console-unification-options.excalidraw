    {
      "type": "text", "id": "s4_r2t", "x": 78, "y": 1458, "width": 370, "height": 56,
      "text": "CSWEB\ncsweb.asiansocial.org/csweb/\nUS Census Bureau software.",
      "originalText": "CSWEB\ncsweb.asiansocial.org/csweb/\nUS Census Bureau software.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid",
