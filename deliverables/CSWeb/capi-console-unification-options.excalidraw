    },
    {
      "type": "text", "id": "s4_21t", "x": 496, "y": 1440, "width": 390, "height": 90,
      "text": "★ The honest answer.\nVendor code with its own\nMySQL user table. It gets a\nnav entry and a new tab —\nnot a costume.",
      "originalText": "★ The honest answer.\nVendor code with its own\nMySQL user table. It gets a\nnav entry and a new tab —\nnot a costume.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 410006, "version": 1, "versionNonce": 410007, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "s4_22", "x": 920, "y": 1424, "width": 420, "height": 124,
      "strokeColor": "#b91c1c", "backgroundColor": "#fecaca", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 410008, "version": 1, "versionNonce": 410009, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "s4_22t", "x": 936, "y": 1440, "width": 390, "height": 90,
      "text": "✗ CSPro emits absolute URLs\nand owns its session cookie.\nProxying puts the CSEntry\nsync path at risk — and sync\nis frozen for pretest.",
      "originalText": "✗ CSPro emits absolute URLs\nand owns its session cookie.\nProxying puts the CSEntry\nsync path at risk — and sync\nis frozen for pretest.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 410010, "version": 1, "versionNonce": 410011, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "s4_23", "x": 1360, "y": 1424, "width": 420, "height": 124,
      "strokeColor": "#b91c1c", "backgroundColor": "#fecaca", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 410012, "version": 1, "versionNonce": 410013, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "s4_23t", "x": 1376, "y": 1440, "width": 390, "height": 90,
      "text": "✗ Authenticates against its\nown users table. SSO means\npatching vendor code you\nwill have to re-patch at\nevery CSWeb upgrade.",
      "originalText": "✗ Authenticates against its\nown users table. SSO means\npatching vendor code you\nwill have to re-patch at\nevery CSWeb upgrade.",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 410014, "version": 1, "versionNonce": 410015, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
