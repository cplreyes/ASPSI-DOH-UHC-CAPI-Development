    {
      "type": "text", "id": "s3c_win", "x": 1340, "y": 1000, "width": 560, "height": 40,
      "text": "✓  Cheapest — no URL churn, no ACL edits, no redirect map\n✓  Still fixes the five-chrome problem, the visible half",
      "originalText": "✓  Cheapest — no URL churn, no ACL edits, no redirect map\n✓  Still fixes the five-chrome problem, the visible half",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 320018, "version": 1, "versionNonce": 320019, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "s3c_cost", "x": 1340, "y": 1048, "width": 560, "height": 40,
      "text": "✗  Two URL spaces survive; the address bar contradicts the nav\n✗  Signpost pages live on as redirects — dead weight in the build",
      "originalText": "✗  Two URL spaces survive; the address bar contradicts the nav\n✗  Signpost pages live on as redirects — dead weight in the build",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
