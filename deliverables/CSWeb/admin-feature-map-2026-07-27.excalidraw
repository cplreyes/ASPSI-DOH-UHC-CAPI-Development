    {"id":"d4t","type":"text","x":1181,"y":308,"width":345,"height":104,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":20,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"8. AUDIT TRAIL        ! DPA RELEVANT\nWho changed what, when. Who downloaded\nmicrodata. NOTHING exists today beyond\nfile backups - no attribution at all.\nstate: none","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"8. AUDIT TRAIL        ! DPA RELEVANT\nWho changed what, when. Who downloaded\nmicrodata. NOTHING exists today beyond\nfile backups - no attribution at all.\nstate: none","lineHeight":1.5},
