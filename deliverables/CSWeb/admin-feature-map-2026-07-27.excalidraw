    {"id":"d2t","type":"text","x":431,"y":308,"width":325,"height":104,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":16,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"6. QA RULES\nGPS accuracy 50 m, sats 4, duplicate\nradius, displacement km. METHODOLOGY\ndecisions currently frozen in code.\nstate: hardcoded in map/dashboard gens","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"6. QA RULES\nGPS accuracy 50 m, sats 4, duplicate\nradius, displacement km. METHODOLOGY\ndecisions currently frozen in code.\nstate: hardcoded in map/dashboard gens","lineHeight":1.5},
    {"id":"d3","type":"rectangle","x":790,"y":296,"width":355,"height":126,"angle":0,"strokeColor":"#1e3a5f","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":17,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"d3t","type":"text","x":806,"y":308,"width":325,"height":104,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":18,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"7. RELEASE & RETENTION\nWhich exports are published, embargo a\nformat, purge/archive a phase's data,\nrun the codebook / tabulations now.\nstate: implicit in generators + cron","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"7. RELEASE & RETENTION\nWhich exports are published, embargo a\nformat, purge/archive a phase's data,\nrun the codebook / tabulations now.\nstate: implicit in generators + cron","lineHeight":1.5},
