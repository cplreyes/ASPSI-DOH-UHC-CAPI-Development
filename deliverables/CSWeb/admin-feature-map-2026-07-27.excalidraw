    {"id":"e2t","type":"text","x":431,"y":480,"width":325,"height":90,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":25,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"10. PROJECTS & INSTRUMENTS\nSecond project (the stated vision) means\nCRUD on projects + instrument registry\n(versions, vars, questionnaires).","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"10. PROJECTS & INSTRUMENTS\nSecond project (the stated vision) means\nCRUD on projects + instrument registry\n(versions, vars, questionnaires).","lineHeight":1.5},
    {"id":"e3","type":"rectangle","x":790,"y":468,"width":750,"height":110,"angle":0,"strokeColor":"#64748b","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":26,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"e3t","type":"text","x":806,"y":480,"width":720,"height":90,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":27,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"ALREADY MANAGED ELSEWHERE - do NOT rebuild:\n  CSWeb app users + case data -> CSWeb's own admin UI      F2 facility links, QR codes, reminder waves -> F2 admin portal\n  Instrument builds / deploys -> CSPro Designer + clasp     Content (guides, manual, crosswalks) -> vault generators\nThe console admin should LINK to these, not duplicate them.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"ALREADY MANAGED ELSEWHERE - do NOT rebuild:\n  CSWeb app users + case data -> CSWeb's own admin UI      F2 facility links, QR codes, reminder waves -> F2 admin portal\n  Instrument builds / deploys -> CSPro Designer + clasp     Content (guides, manual, crosswalks) -> vault generators\nThe console admin should LINK to these, not duplicate them.","lineHeight":1.5},
