    {"id":"d1t","type":"text","x":56,"y":308,"width":325,"height":104,"angle":0,"strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":14,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1,"link":null,"locked":false,"text":"5. ASSIGNMENT PLAN   ! ROLLOUT GATE\nUpload EA plan, set quotas per facility,\nflip PROVISIONAL -> FINAL (kills the\nbadges, makes coverage % real).\nstate: targets.json (265 KB, 1,521 rows)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","baseline":12,"containerId":null,"originalText":"5. ASSIGNMENT PLAN   ! ROLLOUT GATE\nUpload EA plan, set quotas per facility,\nflip PROVISIONAL -> FINAL (kills the\nbadges, makes coverage % real).\nstate: targets.json (265 KB, 1,521 rows)","lineHeight":1.5},
