    {
      "type": "text", "id": "t_rec", "x": 148, "y": 1580, "width": 2050, "height": 72,
      "text": "RECOMMENDATION  —  Option A now, D later.  Externalising the 185 KB plan buys more than any layout change, costs ~40 lines, and changes nothing a user can break.\nThe grid then fixes what Carl actually reported (\"cramped\") by using width instead of more scrolling. Keep C's case-list page in reserve: it becomes worth doing only after D,\nwhen the overview no longer needs the rows. Do B only if D happens — on its own it is four times the work for zero bytes.",
      "originalText": "RECOMMENDATION  —  Option A now, D later.  Externalising the 185 KB plan buys more than any layout change, costs ~40 lines, and changes nothing a user can break.\nThe grid then fixes what Carl actually reported (\"cramped\") by using width instead of more scrolling. Keep C's case-list page in reserve: it becomes worth doing only after D,\nwhen the overview no longer needs the rows. Do B only if D happens — on its own it is four times the work for zero bytes.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500003, "version": 1, "versionNonce": 500004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.5
    }
