    {
      "type": "text", "id": "t_tension", "x": 244, "y": 406, "width": 1290, "height": 92,
      "text": "⚠  The brief assumed 350 KB scales linearly with fieldwork. It does not — 91% of today's page is fixed.\n⚠  The real waste today is the assignment plan: 185 KB of unchanging reference data, re-shipped every 2 minutes.\n⚠  But the case rows are the only linear term, so they still win the argument at rollout scale — see the projection below.",
      "originalText": "⚠  The brief assumed 350 KB scales linearly with fieldwork. It does not — 91% of today's page is fixed.\n⚠  The real waste today is the assignment plan: 185 KB of unchanging reference data, re-shipped every 2 minutes.\n⚠  But the case rows are the only linear term, so they still win the argument at rollout scale — see the projection below.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200042, "version": 1, "versionNonce": 200043, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
