    { "id": "optB_bullets", "type": "text", "x": 770, "y": 474, "width": 610, "height": 130, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 271, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "✓ One store on the box; F2 written + read in the same place\n✗ Live-write cutover of a field-active survey — Carl-gated + destructive\n✗ Collides with the Elestio end-state → likely a 2nd migration (throwaway)\n✗ Needs config/hcws backfill, spec-gate, dead-letter, batch semantics\n✗ All 6 stages; the critical + high findings concentrate in Stages 4–6", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✓ One store on the box; F2 written + read in the same place\n✗ Live-write cutover of a field-active survey — Carl-gated + destructive\n✗ Collides with the Elestio end-state → likely a 2nd migration (throwaway)\n✗ Needs config/hcws backfill, spec-gate, dead-letter, batch semantics\n✗ All 6 stages; the critical + high findings concentrate in Stages 4–6", "lineHeight": 1.5, "baseline": 123 },

    { "id": "rec_box", "type": "rectangle", "x": 120, "y": 636, "width": 1220, "height": 84, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 280, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "rec_t", "type": "text", "x": 140, "y": 650, "width": 1180, "height": 56, "angle": 0, "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 281, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 15, "fontFamily": 2, "text": "RECOMMENDATION — Option A (read-mirror on MySQL). F2 becomes csweb_f2, a 4th breakout DB the dashboard reads through its existing\nq() path — smallest possible change, no new infra, delivers the unified view now, Sheets/Elestio untouched. I'd re-dialect the staged\nPostgres artifacts to MySQL + this scope (drops ~half the 31 findings) and add the F2 section to the generator inline. B stays open later.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RECOMMENDATION — Option A (read-mirror on MySQL). F2 becomes csweb_f2, a 4th breakout DB the dashboard reads through its existing q() path — smallest possible change, no new infra, delivers the unified view now, Sheets/Elestio untouched. I'd re-dialect the staged Postgres artifacts to MySQL + this scope (drops ~half the 31 findings) and add the F2 section to the generator inline. B stays open later.", "lineHeight": 1.3, "baseline": 49 }
