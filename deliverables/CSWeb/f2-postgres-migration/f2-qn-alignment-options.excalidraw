    { "id": "t_f2_t1", "type": "text", "x": 776, "y": 176, "width": 668, "height": 18, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 317, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "F2 — self-administered PWA: no QN anywhere, no names in the store", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "F2 — self-administered PWA: no QN anywhere, no names in the store", "lineHeight": 1.25, "baseline": 12 },
