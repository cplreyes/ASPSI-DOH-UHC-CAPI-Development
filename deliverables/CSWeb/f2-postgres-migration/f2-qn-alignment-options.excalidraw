    { "id": "a_title", "type": "text", "x": 100, "y": 356, "width": 430, "height": 44, "angle": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 330, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "OPTION A  ★ RECOMMENDED NOW\n9-digit facility code as facility_id", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "OPTION A  ★ RECOMMENDED NOW\n9-digit facility code as facility_id", "lineHeight": 1.3, "baseline": 37 },
    { "id": "a_mock", "type": "rectangle", "x": 100, "y": 410, "width": 430, "height": 78, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 331, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "a_mock_t", "type": "text", "x": 114, "y": 420, "width": 402, "height": 58, "angle": 0, "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 332, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 3, "text": "facility_id: 040340002   ← same code9 as F1\ncase id:     761f0eae-…  (UUID stays)\nenrollment convention — NO app change", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "facility_id: 040340002   ← same code9 as F1\ncase id:     761f0eae-…  (UUID stays)\nenrollment convention — NO app change", "lineHeight": 1.45, "baseline": 51 },
    { "id": "a_bullets", "type": "text", "x": 100, "y": 502, "width": 440, "height": 150, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 333, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 2, "text": "✓ Full LOCATION parity — geo names derive from the\n   same PSGC frame, byte-identical to F1/F3/F4\n✓ Coverage-vs-target unlocks: facility_id = code9\n   joins the same targets.json\n✓ Zero app code — ops type the 9-digit code in\n   CreateHCWModal when real enrollment starts\n✓ Decide today, apply when the F2 frame lands\n○ Case key stays UUID (fine: self-administered,\n   one questionnaire per HCW, collision-proof)", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✓ Full LOCATION parity — geo names derive from the\n   same PSGC frame, byte-identical to F1/F3/F4\n✓ Coverage-vs-target unlocks: facility_id = code9\n   joins the same targets.json\n✓ Zero app code — ops type the 9-digit code in\n   CreateHCWModal when real enrollment starts\n✓ Decide today, apply when the F2 frame lands\n○ Case key stays UUID (fine: self-administered,\n   one questionnaire per HCW, collision-proof)", "lineHeight": 1.4, "baseline": 143 },

    { "id": "b_title", "type": "text", "x": 570, "y": 356, "width": 430, "height": 44, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 340, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "OPTION B — LATER, ON TOP OF A\nfull 12-digit QN per F2 case", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "OPTION B — LATER, ON TOP OF A\nfull 12-digit QN per F2 case", "lineHeight": 1.3, "baseline": 37 },
    { "id": "b_mock", "type": "rectangle", "x": 570, "y": 410, "width": 430, "height": 78, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 341, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "b_mock_t", "type": "text", "x": 584, "y": 420, "width": 402, "height": 58, "angle": 0, "strokeColor": "#78350f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 342, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 3, "text": "qn: 040340002·047  ← facility-9 + HCW-seq-3\nassigned at enrollment (not respondent-typed)\nnew field: app + AS + Worker + spec ×2 + mirror", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "qn: 040340002·047  ← facility-9 + HCW-seq-3\nassigned at enrollment (not respondent-typed)\nnew field: app + AS + Worker + spec ×2 + mirror", "lineHeight": 1.45, "baseline": 51 },
    { "id": "b_bullets", "type": "text", "x": 570, "y": 502, "width": 440, "height": 150, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 343, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 2, "text": "✓ Everything in A, PLUS a QN-shaped per-case key —\n   harmonization/tabulation parity (Codebook, Epic 10/11)\n✓ Mirrors F3's patient-seq-within-facility pattern\n✗ Real change to a live instrument: payload field through\n   app→Worker→AS→Sheet + BOTH F2-Spec copies + mirror col\n✗ Needs an HCW-level assignment decision from ASPSI\n   (who numbers the HCWs? enrollment order vs frame)\n○ A is literally B's prefix — nothing built for A is wasted", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✓ Everything in A, PLUS a QN-shaped per-case key —\n   harmonization/tabulation parity (Codebook, Epic 10/11)\n✓ Mirrors F3's patient-seq-within-facility pattern\n✗ Real change to a live instrument: payload field through\n   app→Worker→AS→Sheet + BOTH F2-Spec copies + mirror col\n✗ Needs an HCW-level assignment decision from ASPSI\n   (who numbers the HCWs? enrollment order vs frame)\n○ A is literally B's prefix — nothing built for A is wasted", "lineHeight": 1.4, "baseline": 143 },

    { "id": "c_title", "type": "text", "x": 1040, "y": 356, "width": 420, "height": 44, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 350, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "OPTION C — STATUS QUO\nmap slugs in the mirror only", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "OPTION C — STATUS QUO\nmap slugs in the mirror only", "lineHeight": 1.3, "baseline": 37 },
