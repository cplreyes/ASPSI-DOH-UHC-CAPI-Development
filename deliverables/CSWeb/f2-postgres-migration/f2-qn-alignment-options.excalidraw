    { "id": "title", "type": "text", "x": 100, "y": 30, "width": 1360, "height": 36, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 301, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 27, "fontFamily": 2, "text": "Aligning F2's location identity: adopt the 12-digit Questionnaire Number?", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Aligning F2's location identity: adopt the 12-digit Questionnaire Number?", "lineHeight": 1.25, "baseline": 24 },
    { "id": "context", "type": "text", "x": 100, "y": 74, "width": 1360, "height": 40, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 302, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14, "fontFamily": 2, "text": "The QN is really TWO things: a 9-digit PSGC-coded FACILITY code (the location-bearing part) + a 3-digit case sequence. F2's real enrollment hasn't\nhappened yet (41 demo rows), so this decision shapes fieldwork setup, not a retrofit. Key fact: F2's facility_id is set at HCW enrollment (CreateHCWModal).", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The QN is really TWO things: a 9-digit PSGC-coded FACILITY code (the location-bearing part) + a 3-digit case sequence. F2's real enrollment hasn't happened yet (41 demo rows), so this decision shapes fieldwork setup, not a retrofit. Key fact: F2's facility_id is set at HCW enrollment (CreateHCWModal).", "lineHeight": 1.3, "baseline": 33 },

