    { "id": "t_capi_lbl", "type": "text", "x": 116, "y": 238, "width": 588, "height": 16, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 314, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12, "fontFamily": 3, "text": "reg prov city  fac    case-seq   └── first 9 = code9 → geo names + targets.json join", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "reg prov city  fac    case-seq   └── first 9 = code9 → geo names + targets.json join", "lineHeight": 1.25, "baseline": 10 },
    { "id": "t_capi_note", "type": "text", "x": 116, "y": 264, "width": 588, "height": 32, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 315, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12.5, "fontFamily": 2, "text": "Instrument also stamps region_name / province_name into every case at capture →\ndashboard reads names directly. Coverage joins LEFT(qn,9) ↔ assignment plan.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Instrument also stamps region_name / province_name into every case at capture → dashboard reads names directly. Coverage joins LEFT(qn,9) ↔ assignment plan.", "lineHeight": 1.3, "baseline": 27 },

