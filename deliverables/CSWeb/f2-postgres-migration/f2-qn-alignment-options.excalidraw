    { "id": "c_mock_t", "type": "text", "x": 1054, "y": 420, "width": 392, "height": 58, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 352, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 3, "text": "facility_id: RHU-QC-01  (any format)\nf2_facility_master maps slug → names\nby hand, per facility, forever", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "facility_id: RHU-QC-01  (any format)\nf2_facility_master maps slug → names\nby hand, per facility, forever", "lineHeight": 1.45, "baseline": 51 },
    { "id": "c_bullets", "type": "text", "x": 1040, "y": 502, "width": 430, "height": 130, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 353, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 2, "text": "✓ Zero upstream change of any kind\n✗ Display-level alignment only — no shared code\n   discipline, no coverage join, no QN key\n✗ Manual mapping maintenance per facility, and a\n   typo'd slug silently becomes a new '(unknown)'\n✗ F2 stays the odd one out in the harmonized\n   dataset and every future geo feature", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "✓ Zero upstream change of any kind\n✗ Display-level alignment only — no shared code\n   discipline, no coverage join, no QN key\n✗ Manual mapping maintenance per facility, and a\n   typo'd slug silently becomes a new '(unknown)'\n✗ F2 stays the odd one out in the harmonized\n   dataset and every future geo feature", "lineHeight": 1.4, "baseline": 125 },

    { "id": "rec_box", "type": "rectangle", "x": 100, "y": 672, "width": 1360, "height": 92, "angle": 0, "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 360, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false },
    { "id": "rec_t", "type": "text", "x": 120, "y": 686, "width": 1320, "height": 64, "angle": 0, "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 361, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 14.5, "fontFamily": 2, "text": "RECOMMENDATION — A now, B when the F2 frame lands. Yes to alignment: adopt the QN's location-bearing 9-digit facility code as F2's facility_id\n(an enrollment convention, zero app change, unlocks geo names + coverage). The full 12-digit QN adds only the 3-digit case sequence — real value for\nharmonization (Epic 10/11), but it's an app+spec change on a live instrument and needs ASPSI's HCW-numbering call, so layer it on A when that exists.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RECOMMENDATION — A now, B when the F2 frame lands. Yes to alignment: adopt the QN's location-bearing 9-digit facility code as F2's facility_id (an enrollment convention, zero app change, unlocks geo names + coverage). The full 12-digit QN adds only the 3-digit case sequence — real value for harmonization (Epic 10/11), but it's an app+spec change on a live instrument and needs ASPSI's HCW-numbering call, so layer it on A when that exists.", "lineHeight": 1.35, "baseline": 57 }
  ],
