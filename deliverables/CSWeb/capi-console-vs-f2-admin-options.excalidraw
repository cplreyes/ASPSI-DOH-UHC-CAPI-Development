    {
      "type": "text",
      "id": "s4c_p2note",
      "x": 2865, "y": 1160, "width": 470, "height": 18,
      "text": "Sheets retired as an identity store.",
      "originalText": "Sheets retired as an identity store.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
