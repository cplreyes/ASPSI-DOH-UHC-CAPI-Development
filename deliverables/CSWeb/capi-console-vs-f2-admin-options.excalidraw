    },
    {
      "type": "text",
      "id": "s5_rec_t",
      "x": 100, "y": 1562, "width": 3240, "height": 48,
      "text": "RECOMMENDATION — Option C.  Build the console's identity provider on the VPS now, to F2's standard; after pretest, repoint the F2 Worker at it.\nYou get the F2-quality admin portal immediately and the integration second — with the merge running toward MySQL rather than into a spreadsheet.",
      "originalText": "RECOMMENDATION — Option C.  Build the console's identity provider on the VPS now, to F2's standard; after pretest, repoint the F2 Worker at it.\nYou get the F2-quality admin portal immediately and the integration second — with the merge running toward MySQL rather than into a spreadsheet.",
      "fontSize": 19, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500003, "version": 1, "versionNonce": 500004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
