    {
      "type": "text",
      "id": "s2a_pros",
      "x": 80, "y": 1350, "width": 1040, "height": 80,
      "text": "✓  Console never depends on Cloudflare, Apps Script or Sheets\n✓  PII-adjacent identity lives on the box, in MySQL\n✓  Nothing on F2 changes — safe to build during pretest\n✓  Fastest path to real revocation, MFA and read auditing",
      "originalText": "✓  Console never depends on Cloudflare, Apps Script or Sheets\n✓  PII-adjacent identity lives on the box, in MySQL\n✓  Nothing on F2 changes — safe to build during pretest\n✓  Fastest path to real revocation, MFA and read auditing",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200035, "version": 1, "versionNonce": 200036, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
