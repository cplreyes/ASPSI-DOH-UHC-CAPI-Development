    },
    {
      "type": "text",
      "id": "s2a_cons",
      "x": 80, "y": 1442, "width": 1040, "height": 40,
      "text": "✗  Still two identity systems and two logins\n✗  \"Integrate later\" stays an unscheduled promise",
      "originalText": "✗  Still two identity systems and two logins\n✗  \"Integrate later\" stays an unscheduled promise",
