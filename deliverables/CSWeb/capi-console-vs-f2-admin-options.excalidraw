    {
      "type": "text",
      "id": "s2a_ev_t",
      "x": 125, "y": 1147, "width": 950, "height": 65,
      "text": "console_users     username, argon2id_hash, must_change, totp_secret, status\nconsole_roles     name, version, monitoring_view, case_view, data_export, …\nconsole_sessions  sid, user, issued_at, last_seen, revoked_at  <- real logout\nconsole_audit     ts, actor, verb, path, subject_id            <- who READ what",
      "originalText": "console_users     username, argon2id_hash, must_change, totp_secret, status\nconsole_roles     name, version, monitoring_view, case_view, data_export, …\nconsole_sessions  sid, user, issued_at, last_seen, revoked_at  <- real logout\nconsole_audit     ts, actor, verb, path, subject_id            <- who READ what",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
