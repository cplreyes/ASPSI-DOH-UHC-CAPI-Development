      "id": "s3b_lft",
      "x": 1212, "y": 1075, "width": 296, "height": 54,
      "text": "Every gated request:\nthree external hops\nbefore a byte is served.",
      "originalText": "Every gated request:\nthree external hops\nbefore a byte is served.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
