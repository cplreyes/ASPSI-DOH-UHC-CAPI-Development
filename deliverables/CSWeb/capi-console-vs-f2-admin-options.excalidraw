    {
      "type": "text",
      "id": "s3b_ev_t",
      "x": 1245, "y": 1264, "width": 950, "height": 33,
      "text": "GET /docs/cases/f1/300101001.json    browser sends Cookie, not Bearer\n=> 401.  Static JSON cannot carry a JWT — needs a cookie shim first.",
      "originalText": "GET /docs/cases/f1/300101001.json    browser sends Cookie, not Bearer\n=> 401.  Static JSON cannot carry a JWT — needs a cookie shim first.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300035, "version": 1, "versionNonce": 300036, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
