    },
    {
      "type": "text",
      "id": "s3b_rgt",
      "x": 1940, "y": 1075, "width": 290, "height": 54,
      "text": "If any one of the three\nis down or quota'd,\nthe console is down.",
      "originalText": "If any one of the three\nis down or quota'd,\nthe console is down.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
