    {"id":"tension1","type":"text","x":150,"y":446,"width":950,"height":19,"angle":0,"strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":100090,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":15,"fontFamily":3,"text":"⚠  ReadGPSReading(120, 20) fires onfocus — a synchronous 120-second freeze, BEFORE consent.  F3 pays it twice, per patient.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"⚠  ReadGPSReading(120, 20) fires onfocus — a synchronous 120-second freeze, BEFORE consent.  F3 pays it twice, per patient.","lineHeight":1.25},
    {"id":"tension2","type":"text","x":150,"y":470,"width":950,"height":17,"angle":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":100091,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"Not a hard block — the enumerator can dismiss the error and move on. But the tablet looks frozen, so the field reports \"cannot proceed\".","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Not a hard block — the enumerator can dismiss the error and move on. But the tablet looks frozen, so the field reports \"cannot proceed\".","lineHeight":1.25},

