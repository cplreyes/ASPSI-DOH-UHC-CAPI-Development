    {"id":"win1","type":"text","x":150,"y":846,"width":1000,"height":19,"angle":0,"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":200090,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":15,"fontFamily":3,"text":"✓  The interview never waits on satellites.  Finish → record result → photo → walk out → GPS acquires outdoors.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"✓  The interview never waits on satellites.  Finish → record result → photo → walk out → GPS acquires outdoors.","lineHeight":1.25},
    {"id":"win2","type":"text","x":150,"y":870,"width":1000,"height":17,"angle":0,"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":200091,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"○  Be honest: the 120s stall is RELOCATED, not removed. If they stay indoors at case-close it still freezes — but the respondent is already done.","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"○  Be honest: the 120s stall is RELOCATED, not removed. If they stay indoors at case-close it still freezes — but the respondent is already done.","lineHeight":1.25},
